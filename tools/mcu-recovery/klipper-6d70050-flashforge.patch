+    } while (0)
+#define try_shutdown_ec(code, msg) do {         \
+        ff_shutdown_code = (code);              \
+        try_shutdown(msg);                      \
+    } while (0)
 #define try_shutdown(msg)                       \
     sched_try_shutdown(_DECL_STATIC_STR(msg))
 
