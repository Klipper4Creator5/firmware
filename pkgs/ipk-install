#!/bin/sh
# Install and remove .ipk packages on the printer, with no opkg on the printer.
#
#     ipk-install install <file.ipk> [--root DIR]
#     ipk-install remove  <package>  [--root DIR]
#     ipk-install list               [--root DIR]
#
# WHY THIS EXISTS AT ALL, WHEN THE WHOLE POINT WAS TO USE opkg. Because the
# package format and the package MANAGER are separable, and they cost wildly
# different amounts to get onto this machine. bin/mkipk.sh produces packages
# that real opkg 0.6.3 installs and removes -- that is measured, not hoped, and
# docs/notes/85-packaging.md records how. Getting the opkg BINARY onto the
# printer is a second cross-build (opkg needs libarchive) and its own set of
# ABI gates. This script is what lets phase 1 of that migration ship without
# waiting for phase 2: the packages are real opkg packages either way, and when
# the real client arrives it adopts the database this one wrote.
#
# THE DATABASE IS opkg's, DELIBERATELY, down to the file names:
#
#     $ROOT/$MODDIR/var/lib/opkg/status            one stanza per package
#     $ROOT/$MODDIR/var/lib/opkg/info/<pkg>.control  its control file
#     $ROOT/$MODDIR/var/lib/opkg/info/<pkg>.list     every path it owns
#
# That layout is not a homage. It is what makes phase 2 a swap rather than a
# migration: point a cross-built opkg at this directory with `--offline-root`
# and it reads the packages this script installed as its own. Writing a private
# format here would mean writing a converter later.
#
# ...WHICH IS ALSO WHERE THE ONE TRAP IS, and it is the same trap s6's
# libexecdir set (see versions.env). opkg BAKES ITS lib DIRECTORY IN AT COMPILE
# TIME -- measured: an opkg configured --prefix=/usr/local looks for its status
# file in /usr/local/var/lib/opkg no matter what --offline-root it is given. So
# the opkg built in phase 2 has to be configured --prefix=$MODDIR, exactly like
# s6 and CPython already are, or it will come up believing nothing is installed
# and cheerfully reinstall the world.
#
# NO `ar`. An .ipk is an ar archive, and the obvious implementation of this
# script is two lines of `ar p`. The printer's busybox is 1.31.1 built small --
# it has no `timeout`, no `nc` and no `ionice` applet, all measured on the
# replica rather than assumed -- so `ar` is not something to bet an installer
# on. The header walk below needs `tail -c`, `head -c` and `tar`, and the stock
# FlashForge installer already proves tar and its friends are there.
set -eu

MODDIR=/usr/data/anvil
ROOT=""
CMD="${1:-}"
[ $# -gt 0 ] && shift

ARG=""
while [ $# -gt 0 ]; do
    case "$1" in
        --root) ROOT="$2"; shift 2 ;;
        -*) echo "ipk-install: unknown option $1" >&2; exit 1 ;;
        *) ARG="$1"; shift ;;
    esac
done

DB="$ROOT$MODDIR/var/lib/opkg"
STATUS="$DB/status"
INFO="$DB/info"

die() { echo "ipk-install: $*" >&2; exit 1; }

# ------------------------------------------------------------ the ar walk
#
# An ar archive is an 8-byte magic then, for each member, a 60-byte ASCII
# header followed by the member's bytes padded to an even offset. The header is
# fixed-width fields: name[16] mtime[12] uid[6] gid[6] mode[8] size[10] and a
# two-byte "`\n" terminator. Only the name and the size are needed here, and
# both are plain text, which is why this walk is possible in sh at all.
#
# Members are extracted with tail/head rather than dd: `dd bs=1` over a 400KB
# member is 400,000 one-byte reads, and this runs on a 1.2GHz MIPS core during
# a firmware install.
ar_member() {           # ar_member <archive> <member-name> -> bytes on stdout
    _a=$1; _want=$2; _off=8
    while :; do
        _hdr=$(tail -c "+$((_off + 1))" "$_a" 2>/dev/null | head -c 60) || return 1
        [ -n "$_hdr" ] || return 1
        # The name field is padded with spaces and, on GNU ar, terminated with
        # a slash: "control.tar.gz/ ". Both go.
        _name=$(printf '%s' "$_hdr" | cut -c1-16 | tr -d ' ' | sed 's|/$||')
        _size=$(printf '%s' "$_hdr" | cut -c49-58 | tr -d ' ')
        [ -n "$_size" ] || return 1
        _data=$((_off + 60))
        if [ "$_name" = "$_want" ]; then
            tail -c "+$((_data + 1))" "$_a" | head -c "$_size"
            return 0
        fi
        # Members start on even offsets; an odd-sized one is followed by a
        # padding byte that is not part of the next header.
        _off=$((_data + _size))
        [ $((_off % 2)) -eq 0 ] || _off=$((_off + 1))
    done
}

ctrl_field() {          # ctrl_field <file> <Field> -> value
    sed -n "s/^$2: //p" "$1" | head -1
}

# ------------------------------------------------------------------ install
do_install() {
    ipk=$ARG
    [ -f "$ipk" ] || die "no such package: $ipk"

    tmp="${TMPDIR:-/tmp}/ipk-install.$$"
    rm -rf "$tmp"; mkdir -p "$tmp/control" "$INFO"
    # shellcheck disable=SC2064
    trap "rm -rf '$tmp'" EXIT

    ar_member "$ipk" debian-binary > "$tmp/debian-binary" \
        || die "$ipk has no debian-binary member -- not an ipk"
    case "$(cat "$tmp/debian-binary")" in
        2.0*) ;;
        *) die "$ipk declares format '$(cat "$tmp/debian-binary")', expected 2.0" ;;
    esac

    ar_member "$ipk" control.tar.gz > "$tmp/control.tar.gz" \
        || die "$ipk has no control.tar.gz"
    tar -xzf "$tmp/control.tar.gz" -C "$tmp/control"
    [ -f "$tmp/control/control" ] || die "$ipk: control.tar.gz has no ./control"

    pkg=$(ctrl_field "$tmp/control/control" Package)
    ver=$(ctrl_field "$tmp/control/control" Version)
    arch=$(ctrl_field "$tmp/control/control" Architecture)
    [ -n "$pkg" ] || die "$ipk: control has no Package field"

    # THE ARCHITECTURE CHECK IS NOT A FORMALITY HERE. Every OpenWrt feed in the
    # world carries mipsel_24kc packages for this exact ISA and ABI, built
    # against musl. One of those installed onto this printer would put a
    # library in $MODDIR/lib that nothing can load, and the failure would
    # surface as an import error three layers away. See IPK_ARCH in
    # bin/common.sh.
    case "$arch" in
        mipsel_xburst2|all) ;;
        *) die "$pkg is built for '$arch'; this printer takes mipsel_xburst2" ;;
    esac

    # An install over an existing version is a remove followed by an install,
    # so that a file the old version owned and the new one does not is gone
    # rather than orphaned. That is the same property bin/patch.sh's install
    # manifest exists to give the tarball -- see payload/run-append.sh, where
    # the bill for not having it came due as two init scripts starting nginx
    # twice.
    if [ -f "$INFO/$pkg.list" ]; then
        echo "ipk-install: upgrading $pkg (was $(ctrl_field "$INFO/$pkg.control" Version))"
        remove_files "$pkg"
    fi

    ar_member "$ipk" data.tar.gz > "$tmp/data.tar.gz" || die "$ipk has no data.tar.gz"
    mkdir -p "${ROOT:-/}"
    tar -xzf "$tmp/data.tar.gz" -C "${ROOT:-/}"

    # The file list, read back out of the archive rather than off the disk:
    # what the package OWNS is what it shipped, and a `find` over the install
    # root afterwards would also collect whatever else was already there.
    mkdir -p "$INFO"
    tar -tzf "$tmp/data.tar.gz" | sed -e 's|^\./|/|' -e 's|/$||' \
        | grep -v '^$' | sort > "$INFO/$pkg.list"
    cp "$tmp/control/control" "$INFO/$pkg.control"

    # The status stanza. Rewritten wholesale rather than appended to, so a
    # reinstall leaves one stanza and not two -- opkg reads the first match and
    # a duplicate would make `remove` and `list` disagree.
    _status_without "$pkg" > "$STATUS.new"
    {
        cat "$tmp/control/control"
        printf 'Status: install user installed\n'
        printf 'Installed-Time: %s\n' "$(date +%s)"
        printf '\n'
    } >> "$STATUS.new"
    mv "$STATUS.new" "$STATUS"

    echo "ipk-install: installed $pkg $ver ($(wc -l < "$INFO/$pkg.list") paths)"
}

# Every stanza in the status file except the named package's. awk over
# blank-line-separated records, which is what a status file is.
_status_without() {
    [ -f "$STATUS" ] || { mkdir -p "$DB"; return 0; }
    awk -v drop="$1" 'BEGIN{RS="";ORS="\n\n"} $0 !~ ("(^|\n)Package: " drop "(\n|$)")' \
        "$STATUS"
}

# ------------------------------------------------------------------- remove
#
# Split from do_remove because an upgrade needs the files gone but the database
# rewritten rather than emptied. Takes the package name as an argument rather
# than reading $ARG: `ARG=x do_remove_files` is a prefix assignment on a
# FUNCTION, and whether it survives the call is unspecified in POSIX and
# differs between dash and bash. An installer is the wrong place to find that
# out.
remove_files() {
    _pkg=$1
    _lst="$INFO/$_pkg.list"
    [ -f "$_lst" ] || die "$_pkg is not installed"
    # Files and symlinks first, then directories deepest-first, so a directory
    # is only removed once whatever it held is gone.
    while IFS= read -r p; do
        [ -n "$p" ] || continue
        case "$p" in
            /*) ;;
            # A package's file list is data on disk and this loop runs as root
            # with $ROOT pasted onto the front of whatever it says. The same
            # argument payload/run-append.sh makes about the install manifest:
            # an absolute path is required, so anything else is damage or
            # forgery and the answer is to say so and skip.
            *) echo "ipk-install: refusing '$p' -- not an absolute path" >&2; continue ;;
        esac
        if [ -L "$ROOT$p" ] || [ ! -d "$ROOT$p" ]; then
            rm -f "$ROOT$p"
        fi
    done < "$_lst"
    # rmdir and not rm -r, and the failure is EXPECTED rather than tolerated: a
    # package's file list names every directory it unpacked through, so
    # libsodium's includes /usr and /usr/data. Those are the rootfs's and are
    # full of other things; rmdir refuses them and that refusal is the safety.
    # Hence `|| true` -- without it `set -e` ends the removal at the first
    # shared directory, which is how a reinstall came to leave the new files
    # unpacked and the database unwritten.
    sort -r "$_lst" | while IFS= read -r p; do
        if [ -d "$ROOT$p" ] && [ ! -L "$ROOT$p" ]; then
            rmdir "$ROOT$p" 2>/dev/null || true
        fi
    done
}

do_remove() {
    pkg=$ARG
    remove_files "$pkg"
    _status_without "$pkg" > "$STATUS.new" || true
    mv "$STATUS.new" "$STATUS"
    rm -f "$INFO/$pkg.list" "$INFO/$pkg.control"
    echo "ipk-install: removed $pkg"
}

do_list() {
    [ -f "$STATUS" ] || return 0
    awk 'BEGIN{RS="";FS="\n"} {p="";v="";
         for(i=1;i<=NF;i++){ if($i ~ /^Package: /){p=substr($i,10)}
                             if($i ~ /^Version: /){v=substr($i,10)} }
         if(p!="") printf "%s - %s\n", p, v}' "$STATUS"
}

case "$CMD" in
    install) [ -n "$ARG" ] || die "install needs a .ipk"; do_install ;;
    remove)  [ -n "$ARG" ] || die "remove needs a package name"; do_remove ;;
    list)    do_list ;;
    *) echo "usage: ipk-install {install <file.ipk>|remove <pkg>|list} [--root DIR]" >&2
       exit 1 ;;
esac
