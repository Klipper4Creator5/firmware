#!/bin/sh
# nginx -- the Mainsail web UI on :80.
#
# The binary already ships on stock firmware -- FlashForge simply comments it
# out of /usr/prog/klipper/start.sh and serves its own HTTP API from firmwareExe
# instead. The mod replaces firmwareExe, so that API is gone and this is the
# only web server on the printer. Nothing is built or shipped for it beyond the
# config and the Mainsail files under $MODDIR: we start the binary FlashForge
# already put there, pointed at our own prefix so nothing writes to /usr/prog.
#
# THIS AND S62moonraker WERE ONE SCRIPT, S60web. They are separated because
# they fail separately and are debugged separately: nginx not starting is a
# missing config or a port already bound, and is instant; moonraker not
# starting is a component that failed to import, and takes a background check
# and a log tail to even notice. One script had to say "web: stopped" for both,
# and `status` reported on two unrelated things at once. Splitting them means
# `S62moonraker restart` over ssh -- which is the one you actually want, over
# and over, while chasing a moonraker config -- no longer takes the UI down
# with it.
#
# THE NUMBERING IS LOAD-BEARING. firmwareExe runs $MODDIR/init.d/S* in filename
# order, so this runs before S62moonraker, which runs before S65camera. nginx
# first is the useful order: it proxies both of the others (moonraker on 7125
# and the camera's :8080 stream through /webcam/), and when it is up first the
# browser gets a page that says the backend is not answering yet, rather than a
# refused connection that says nothing at all. It also runs AFTER S40s6, which
# is what starts the supervisor this script now hands the work to, and that
# ordering is not a coincidence either -- see below.
#
# THERE IS NO SWITCH ANY MORE. This script and S62moonraker used to read
# MOD_WEB out of anvil.conf and return early if it was 0, which left a printer
# with ssh and the touchscreen only. It was described as a debugging switch and
# it earned that description exactly once; what it cost the rest of the time
# was a second state for every question anyone asked about the web stack --
# every gate, every test, every `down` file argued about both. Mainsail and
# moonraker are what this mod IS. A printer that does not want them wants a
# stock FlashForge package, which is a thing that exists and is one flash away.
#
# WHAT CHANGED WHEN s6 ARRIVED, and what deliberately did not. nginx is now a
# supervised service: $MODDIR/etc/s6/nginx/ holds a `run` script, s6-supervise
# runs it, and when nginx dies s6 starts it again. That is the whole point --
# before this, a master process that fell over stayed fallen until somebody
# noticed the UI was gone and ssh'd in, and this script had no way to do
# anything about it because a shell that has returned cannot restart anything.
#
# THE INTERFACE IS UNCHANGED, on purpose. `S60nginx restart` over ssh is in the
# docs and in people's hands, and changing the supervisor is not a reason to
# change what people type. So start/stop/restart/status all still exist, still
# say "nginx: ...", and still mean what they meant; underneath, each of them is
# now a couple of svc_s6_* calls instead of a start-stop-daemon invocation and
# a pidfile. What that buys is the same thing the shared library was written
# for: the waiting is done by C that s6 maintains rather than by a `while
# kill -0 ...; sleep 1` we maintain, and `restart` cannot race its own start.
#
# WHY $MODDIR/etc/s6/nginx/down STILL SHIPS, now that no flag needs it. It is
# ORDERING, and it always was the larger half of the argument: s6-svscan starts
# a service the instant the directory appears, which is before this script has
# checked that nginx exists, that its config is where it thinks it is, and that
# moonraker is coming up behind it. `down` means the scanner supervises and
# waits, and start() below is what decides the moment. The long version is in
# the `down` file, next to the thing it explains.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
# The library path and the interpreter, from the one file that defines them.
# See anvil-env.sh for why naming them here instead was a bug. nginx itself
# needs nothing from it -- it links against the base rootfs -- but a script
# that is re-run over ssh should get the same environment on every path, and
# sourcing it twice is a no-op.
if [ -f $MODDIR/anvil-env.sh ]; then
    . $MODDIR/anvil-env.sh
else
    echo "nginx: !! no $MODDIR/anvil-env.sh -- the mod payload is not installed"
fi
# start/stop/status/liveness, shared with the other services. See
# anvil-service.sh for the whole API -- including the svc_s6_* helpers, which
# are what the three verbs below are built out of.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "nginx: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=nginx

NGINX=/usr/prog/nginx/sbin/nginx
NGINX_PID=$MODDIR/nginx/logs/nginx.pid
# The service directory the scanner watches, spelled out of the two variables
# anvil-service.sh defines so that this script and S40s6 cannot disagree about
# where the scandir is. The name is the service name, which is also SVC_NAME,
# which is also what every line this script prints starts with; that is one
# fewer thing to keep in step by hand.
SVCDIR=$SVC_S6_SCANDIR/$SVC_NAME

# Is there a live s6-supervise for our service directory RIGHT NOW?
#
# Two separate questions hide in "is s6 there", and both have to be yes before
# any of the verbs below can use it. svc_s6_running answers the first -- is the
# SCANNER alive and listening -- and does it by behaviour, by pinging the
# control FIFO. This answers the second: has that scanner actually picked our
# directory up and started a supervisor for it? A scandir the scanner has not
# read yet (the payload was extracted after S40s6 ran; somebody dropped the
# directory in by hand) looks exactly like a scandir with no nginx in it, and
# `s6-svc` against it fails with "supervisor not running" -- which is a true
# statement about a state that fixes itself the moment the scanner rescans.
#
# s6-svok is that question in one syscall: it opens the supervise/control FIFO
# and exits 0 only if a supervisor has it open at the other end. Same technique
# as svc_s6_running, one level down, and the same reason for preferring it to a
# test for the directory: a servicedir on disk with no supervisor behind it is
# the stale-pidfile lie all over again.
supervised() {
    [ -x "$SVC_S6_BIN/s6-svok" ] || return 1
    "$SVC_S6_BIN/s6-svok" "$SVCDIR"
}

# Ask the scanner to pick up the service directory, then wait a moment for the
# supervisor to appear. svc_s6_running IS the rescan request -- `s6-svscanctl
# -a` is what it pings with -- so this is one call doing two jobs, which is
# worth saying out loud because it does not look like it does. The bound is 5
# seconds and is only ever paid on a printer where something is already wrong:
# on a normal boot the payload was extracted long before S40s6 started the
# scanner, so the supervisor is already there and the first test succeeds.
# Anything that spends time here is spending firmwareExe's boot, one script at
# a time in the foreground, which is why it is 5 and not 30.
await_supervisor() {
    supervised && return 0
    svc_s6_running || return 1
    _ng_waited=0
    while ! supervised && [ $_ng_waited -lt 5 ]; do
        sleep 1
        _ng_waited=$((_ng_waited + 1))
    done
    unset _ng_waited
    supervised
}

# ---- the fallback, and why it exists ---------------------------------------
#
# WHAT HAPPENS WHEN THERE IS NO SUPERVISOR. MOD_S6=0 is a switch S40s6 honours,
# so "no scanner" is a state a user can choose; and a payload whose s6 failed
# to build, or an install that got half way, is a state nobody chose but that
# happens anyway. The choice is between refusing to start and starting nginx
# the old way, and this script starts it the old way. The reasoning:
#
#   * The failure this would otherwise produce is a printer with no web UI and
#     no way to be told why, because the way you would be told is a web UI.
#     ssh is the remaining door; a printer that loses Mainsail because a
#     SUPERVISOR did not build has lost it for a reason that has nothing to do
#     with nginx.
#   * The old path is not hypothetical or unmaintained -- it is the code that
#     shipped for the whole life of this script, it is nine lines, and
#     case-moonraker.sh still exercises it, because that case starts nginx
#     without a scanner anywhere in sight.
#   * The classic reason NOT to fall back is that you end up with two of them:
#     a directly-started nginx, then a scanner arriving later and starting a
#     second one on a port that is already bound. That cannot happen here, and
#     it is the `down` file that makes it so -- the scanner never starts nginx
#     on its own, only this script does. And when this script does, the `run`
#     script sweeps any nginx that is already running before exec'ing its own,
#     so the hand-over from the fallback to the supervised copy is clean rather
#     than a fight over :80.
#
# What it is NOT allowed to be is silent. A printer running the fallback has
# lost automatic restart-on-crash without losing the web UI, which is exactly
# the kind of half-degraded state that gets discovered six months later, so it
# says so every time, with "!!", which is what people grep a boot log for.
start_unsupervised() {
    svc_warn "no supervisor -- starting nginx directly, it will NOT be restarted if it dies"
    # -p sets the prefix: logs, the pidfile and the temp directories all land
    # under $MODDIR on the data partition, never on /usr/prog. nginx will not
    # start if it cannot create them, and it does not create them itself.
    if $NGINX -p $MODDIR/nginx -c $MODDIR/nginx/nginx.conf; then
        svc_say "started (unsupervised)"
        return 0
    fi
    # nginx has already printed its own reason on stderr, which is in the
    # boot log right above this line. Do not paraphrase it.
    svc_warn "FAILED to start -- see the error above"
    return 1
}

start() {
    # The two prerequisites this script has always checked, in the same order
    # and with the same words, because they are the two things that are
    # actually missing when nginx does not start and neither of them is any
    # less true under a supervisor. A missing prerequisite is REPORTED and
    # returns non-zero; it is not a crash and it is not a stack trace out of
    # s6, which is what handing a supervisor a service it cannot run produces.
    if [ ! -x "$NGINX" ]; then
        svc_warn "no $NGINX -- this printer's firmware did not ship one"
        return 1
    fi
    if [ ! -f $MODDIR/nginx/nginx.conf ]; then
        svc_warn "no $MODDIR/nginx/nginx.conf -- the install did not complete"
        return 1
    fi
    mkdir -p $MODDIR/nginx/logs $MODDIR/nginx/tmp

    # The third prerequisite, which is new: the service directory itself. It is
    # staged into the payload by bin/patch.sh and named in the install
    # manifest, so its absence means a payload that was built without it or an
    # install that did not finish -- and it is deliberately NOT created here.
    # Writing it at runtime would mean the scandir contained a directory no
    # manifest lists, which is the exact thing the manifest exists to stop, and
    # it would put the `run` script's text inside this file where nobody would
    # ever look at it again.
    if [ ! -x "$SVCDIR/run" ]; then
        svc_warn "no $SVCDIR/run -- this payload did not ship the s6 service"
        start_unsupervised
        return $?
    fi

    if ! await_supervisor; then
        start_unsupervised
        return $?
    fi

    # And up it goes. svc_s6_up is `s6-svc -wu -u` with a bound: it asks for the
    # service to be brought up -- overriding the `down` file, which is how a
    # supervised-but-idle service becomes a running server -- and does not
    # return until it IS up. 10 rather than the default 15 seconds because nginx
    # coming up is a bind() and a fork() and nothing else: it is either up in
    # well under a second or it is not coming up at all, and every second spent
    # here is a second firmwareExe is not spending on moonraker, the camera and
    # Klipper.
    if svc_s6_up "$SVC_NAME" 10; then
        svc_say "started -- `svc_s6_stat "$SVC_NAME"`"
        return 0
    fi
    # Up it did not come. s6 has kept the reason where a reason belongs: the
    # `run` script's stderr is the scanner's stderr, which S40s6 points at
    # /usr/data/logs/s6.log, and nginx says precisely why it would not start
    # (an unreadable config, a port already bound) on stderr. Say where, rather
    # than paraphrasing something we have not read.
    svc_warn "FAILED to come up -- `svc_s6_stat "$SVC_NAME"` -- see /usr/data/logs/s6.log"
    return 1
}

stop() {
    # A stop that the supervisor undoes is the classic mistake of this
    # migration, and `s6-svc -d` is what makes it not happen: it does not just
    # signal the process, it tells s6 the service is WANTED DOWN, and s6 then
    # does not start it again until something says otherwise. Killing the pid
    # instead -- which is all this script could do before, and all
    # svc_stop_daemon still does below -- would get nginx restarted a second
    # later by a supervisor that was doing exactly what it was asked to do.
    #
    # -wD (inside svc_s6_down) is the other half: it returns when the service
    # is really down, not when the signal has been sent. That is the busybox
    # start-stop-daemon correction from anvil-service.sh, except in C.
    if supervised; then
        svc_s6_down "$SVC_NAME" || svc_warn "still not down -- `svc_s6_stat "$SVC_NAME"`"
        # nginx writes logs/nginx.pid even with `daemon off;` -- measured on
        # the replica -- so a supervised run leaves one behind, and it is a pid
        # that the kernel is now free to hand to something else. The fallback
        # path below is the only thing that reads this file, and it is exactly
        # the stale-pidfile lie anvil-service.sh has two comments about, so it
        # goes here rather than being left for it to trip over.
        rm -f "$NGINX_PID"
        svc_say "stopped"
        return 0
    fi
    # No supervisor: whatever is running was started by start_unsupervised (or
    # by a hand-run nginx), so it is the pidfile that has to be signalled. The
    # wait matters here too: the master process takes a moment to reap its
    # workers, and returning before it has is how `restart` came back to a port
    # that was still bound.
    svc_stop_daemon "$NGINX_PID"
    svc_say "stopped"
}

status() {
    # Asked of the supervisor when there is one, because it is the only thing
    # that knows. s6-svstat's own wording is passed through -- "up (pid 1234
    # pgid 1234) 71 seconds", "down (signal SIGTERM) 4 seconds, normally up" --
    # for the reason anvil-service.sh gives for svc_s6_stat: it is the answer
    # you came for, in the shape you would have typed the command to get.
    #
    # The words "running" and "not running" are still the first thing on the
    # line, though, and that is not decoration either. It is the vocabulary
    # every other service in init.d/ answers in, it is what a human skims a
    # boot log for, and it is what case-moonraker.sh looks for when it checks
    # that stopping moonraker did not take the web server down with it. The
    # s6 detail is appended to it rather than replacing it.
    if supervised; then
        _ng_stat=`svc_s6_stat "$SVC_NAME"`
        case "$_ng_stat" in
            up*) svc_say "running -- $_ng_stat" ;;
            *)   svc_say "not running -- $_ng_stat" ;;
        esac
        unset _ng_stat
        return 0
    fi
    # No supervisor, so the pidfile is all there is -- and it is worth saying
    # that the answer is coming from a weaker source than usual, because "not
    # running" from a pidfile and "not running" from s6 are not the same claim.
    svc_pid_alive "$NGINX_PID" \
        && svc_say "running (unsupervised, pid `cat "$NGINX_PID" 2>/dev/null`)" \
        || svc_say "not running (no supervisor; asked the pidfile)"
}

svc_dispatch "$@"
