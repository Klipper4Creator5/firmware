#!/bin/sh
# Camera -- mjpg-streamer on :8080, supervised by s6.
#
# WHY THIS EXISTS -- the same trap as WiFi. /usr/prog/mjpg-streamer ships on
# stock firmware (mjpg_streamer, input_uvc.so, output_http.so, its own
# libjpeg.so.9 and a www/ dir), and app_startup.sh only ever exports
# LD_LIBRARY_PATH for it -- it never launches it. firmwareExe did, and in fact
# served the stream from its own OpenCV capture, labelling itself
# "Server: MJPG-Streamer/0.2". So the moment the mod replaces firmwareExe the
# camera goes dark, with a perfectly good streamer sitting unused on the disk.
#
# Nothing has to be built or shipped for this: we start the binary FlashForge
# already put there. Mainsail then finds it through the [webcam] entry in
# moonraker.conf, which points at nginx's /webcam/ proxy rather than :8080
# directly, so a tunnel that forwards one port still shows the stream.
#
# WHAT CHANGED IN PHASE 4. This script used to BE the supervisor. It carried a
# `while true; do mjpg_streamer ...; sleep 3; done` respawn loop and a poll
# that waited up to thirty seconds for /dev/video0, both inside a background
# subshell held open by a pidfile -- a pidfile that pointed at THE LOOP rather
# than at the streamer, because killing only the streamer got it restarted
# three seconds later. All of that now lives in s6:
#
#   the respawn loop  ->  s6-supervise, which is C and does not race itself
#   the 30s poll      ->  the top of $MODDIR/etc/s6/camera/run, where a
#                         timeout means "exit and let s6 try again" instead of
#                         "give up until a human reruns this script"
#   "is it running?"  ->  s6-svstat, asked of the supervisor rather than
#                         guessed from `ps | grep mjpg_streamer`
#   the stop dance    ->  s6-svc -wD -d, which marks the service down BEFORE
#                         signalling it and returns only when it is gone
#
# What is left here is the INTERFACE. `S65camera restart` over ssh is in the
# docs and in people's hands, and changing the supervisor is not a reason to
# change the thing people type. Every verb still works, still says "camera:",
# and still returns promptly.
#
# IT STILL MUST NOT MAKE THE BOOT WAIT, and the shape of that has changed. It
# is no longer this script that waits for the camera at all -- the run script
# does. But somebody has to SAY, in the boot log, whether the camera came up,
# and that answer takes up to thirty seconds to exist. So start() asks s6 to
# bring the service up (fast: -wu returns as soon as the streamer is forked)
# and detaches a reporter that blocks on READINESS and prints the verdict when
# it arrives. The boot never waits on hardware; the log still gets the truth,
# just out of order with the services that started after this one. That is
# svc_detach, and it is the same trade S50wifi makes -- see anvil-service.sh.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
[ -f $MODDIR/anvil-env.sh ] && . $MODDIR/anvil-env.sh
# start/stop/status/liveness, shared with the other services -- including the
# svc_s6_* helpers this script is now written almost entirely in. See
# anvil-service.sh for the whole API.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "camera: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=camera

# The name of the service DIRECTORY inside SVC_S6_SCANDIR, which is a different
# thing from SVC_NAME even though they are spelled the same today: SVC_NAME is
# what this script calls itself in the log, S6NAME is what s6 calls the thing
# it supervises. Keeping them as two variables is what stops a future rename of
# one from silently renaming the other.
S6NAME=camera
S6DIR=$SVC_S6_SCANDIR/$S6NAME

CAMDIR=/usr/prog/mjpg-streamer
VIDEO=/dev/video0
LOG=/usr/data/logs/mjpg.log
RES="${MOD_CAM_RES:-1280x720}"
FPS="${MOD_CAM_FPS:-30}"
PORT="${MOD_CAM_PORT:-8080}"

# The pidfile the OLD supervisor used. Nothing here writes it any more; it is
# named only so stop() can clean up after a payload that did -- see the comment
# there. Once no printer in the field can still be running the pre-phase-4
# payload this and the two lines that use it can go.
LEGACY_PIDFILE=$MODDIR/mjpg.pid

# ---- what to do when there is no supervisor --------------------------------
#
# MOD_S6=0 in anvil.conf turns the scanner off, and a payload whose s6 build
# went wrong has no scanner either -- the -D_FILE_OFFSET_BITS=64 trap in
# tools/supervisor/README.md produces binaries that exec fine and then go blind
# on readdir(). Both are real states on a real printer, and both used to be
# impossible because this script supervised itself.
#
# The choice here is to DEGRADE LOUDLY AND DO NOTHING, rather than to fall back
# to the old hand-rolled loop. Keeping the loop as a fallback would mean two
# implementations of the camera, one of them exercised only on printers that
# are already broken and therefore never tested -- which is precisely how the
# five services grew five different liveness checks in the first place. It
# would also be the worst kind of failure to diagnose: a camera that works
# means nobody notices the supervisor is dead until Klipper needs it too.
#
# So: one line naming the actual problem, and a non-zero exit. firmwareExe
# already prints the exit status of a service that fails, S40s6 has already
# printed its own "not answering" warning by this point in the boot, and the
# two lines together say the whole story. A printer with no camera is a
# printer with no camera; a printer with no supervisor is about to have larger
# problems, and hiding one behind the other helps nobody.
s6_or_complain() {
    if svc_s6_running; then
        return 0
    fi
    svc_warn "the s6 supervisor is not running -- nothing can start the camera"
    svc_warn "check MOD_S6 in $MODDIR/anvil.conf, then $MODDIR/init.d/S40s6 status"
    return 1
}

# Wait for s6-supervise to appear for our service directory, then bring it up.
#
# WHY THIS IS NOT JUST svc_s6_up. s6-svc talks to $S6DIR/supervise/control, a
# FIFO that s6-supervise creates -- and s6-supervise only exists once the
# SCANNER has noticed the directory. On a first boot after an update the
# directory is brand new: the scandir was scanned before the payload landed, or
# scanned when the directory was empty, and the scanner has not looked since.
# svc_s6_running is what pokes it -- `s6-svscanctl -a` is literally the request
# to rescan, which is why the liveness check and the rescan are the same call
# -- but the scan, the fork and the mkfifo take a moment, and a s6-svc that
# arrives during that moment fails with "unable to control" rather than
# waiting. Five one-second tries covers it with room to spare and costs
# nothing on the normal path, where the first attempt succeeds.
s6_up_when_ready() {
    _cam_try=0
    while [ $_cam_try -lt 5 ]; do
        if svc_s6_up "$S6NAME" 15; then
            unset _cam_try
            return 0
        fi
        sleep 1
        _cam_try=$((_cam_try + 1))
    done
    unset _cam_try
    return 1
}

# The detached half. Nothing reads its exit code; it reports through the boot
# log only, exactly as the old detached supervise() did.
#
# svc_s6_ready blocks on s6-svwait -U, which returns when the run script writes
# to its notification-fd -- and the run script does that only once the streamer
# has BOUND ITS PORT, not when it was forked. So the "streaming" line below is
# true when it is printed, which is the entire difference between this and the
# old "waiting for /dev/video0 in the background" that was printed hopefully
# and never followed up.
#
# 35 seconds, not 30: the run script waits up to 30 for the device and then
# still has to start the streamer and bind the port. A caller-side bound equal
# to the callee's would report "not ready" for a camera that was about to work.
ready_report() {
    if svc_s6_ready "$S6NAME" 35; then
        svc_say "streaming on :$PORT ($RES @ ${FPS}fps)"
    else
        svc_warn "not streaming after 35s -- no camera at $VIDEO? see $LOG"
    fi
}

start() {
    # MOD_CAM USED TO BE READ HERE and is gone. A printer with no camera does
    # not need a switch: the checks below already find that out -- there is no
    # $VIDEO, mjpg-streamer says so, and the log says which. The switch existed
    # to skip a 35-second wait for a camera that was known to be absent, and
    # what it actually did was give every question about the camera two
    # answers. The `down` file in the service directory stays, for the reason
    # written inside it: it is what stops s6 starting the streamer before this
    # script has looked for the device.
    s6_or_complain || return 1
    if [ ! -d "$S6DIR" ]; then
        svc_warn "no service directory at $S6DIR -- this payload did not ship it"
        return 1
    fi
    # Kept from the pre-s6 script, and it still earns its place: without it the
    # first sign of a stock firmware that moved or dropped mjpg-streamer would
    # be s6 respawning a run script that fails on exec, once a second, forever.
    # Saying it once here is cheaper to read than that in a log.
    [ -x "$CAMDIR/mjpg_streamer" ] || { svc_warn "no $CAMDIR/mjpg_streamer"; return 1; }

    if ! s6_up_when_ready; then
        svc_warn "s6 would not bring $S6NAME up: `svc_s6_stat "$S6NAME"`"
        return 1
    fi
    # Up, not ready. The difference is the whole point of the next two lines.
    svc_detach ready_report
    svc_say "starting under s6; waiting for $VIDEO in the background (:$PORT, $RES @ ${FPS}fps)"
    return 0
}

stop() {
    # THE OLD ORDERING PROBLEM IS GONE, and it is worth saying why rather than
    # just deleting the comment that explained it. The old stop() had to kill
    # the supervisor FIRST and the streamer second, because the supervisor was
    # our own `while true; ... sleep 3` loop: signal the streamer while the
    # loop still lived and the loop simply started another one three seconds
    # later, so a stop in the wrong order looked like it had worked and had
    # not. Then it had to wait fifteen seconds for the streamer to actually
    # die, because killall returns as soon as the signal is sent and a start()
    # arriving a moment later would see the dying process, say "already
    # running", and leave the camera dark.
    #
    # s6-svc -d makes all three of those disappear, and not by being careful in
    # a different order -- by not having the race. It sets the service's wanted
    # state to DOWN and only then signals it, so there is no window in which
    # something is still trying to bring it back; and -wD does not return until
    # the process is really gone, which is the wait we were hand-rolling. The
    # supervisor itself is deliberately NOT killed: it stays, idle, holding the
    # service in the down state, which is what makes the next `start` a single
    # s6-svc -u instead of a rescan.
    if svc_s6_running && [ -d "$S6DIR" ]; then
        svc_s6_down "$S6NAME" 15 >/dev/null 2>&1 \
            || svc_warn "s6 did not report $S6NAME down: `svc_s6_stat "$S6NAME"`"
    fi

    # THE UPGRADE PATH, and the one place the deleted code still matters. A
    # printer running the pre-phase-4 payload has our old respawn loop alive
    # with its pid in $LEGACY_PIDFILE. Install this payload, then type
    # `S65camera restart` instead of rebooting, and without these two lines
    # that loop is still there -- respawning mjpg_streamer on :8080 and
    # fighting the s6 service for the port, with neither side ever winning and
    # nothing in any log saying why. svc_stop_daemon returns 0 immediately when
    # the pidfile does not exist, which is every printer that has rebooted
    # once, so this costs nothing in the normal case.
    if [ -f "$LEGACY_PIDFILE" ]; then
        svc_warn "found a pre-s6 respawn loop still running -- stopping it"
        svc_stop_daemon "$LEGACY_PIDFILE"
        killall mjpg_streamer 2>/dev/null
    fi
    svc_say "stopped"
}

status() {
    # Asked of the supervisor, not of the process table. `ps | grep
    # mjpg_streamer` was the old answer and it could not tell a streamer that
    # is up from one that s6 is about to respawn, nor say anything at all about
    # a service that is deliberately down. s6-svstat's own wording -- "up (pid
    # 1234) 71 seconds", "down 5 seconds, normally up" -- is already the answer
    # you came for, so it is passed through rather than paraphrased, exactly as
    # S50wifi passes ifconfig through.
    #
    # The no-scanner case still prints a line and still names itself: a service
    # that answers `status` with silence is indistinguishable from one that
    # crashed, and every service in this directory owes the boot log an answer.
    if svc_s6_running; then
        if [ -d "$S6DIR" ]; then
            svc_say "s6: `svc_s6_stat "$S6NAME"`"
        else
            svc_say "no service directory at $S6DIR"
        fi
    else
        svc_say "not running -- the s6 supervisor is not running either"
    fi
    # And the hardware, which is the question somebody actually has when the
    # stream is black. Kept verbatim from the pre-s6 script.
    [ -e "$VIDEO" ] && svc_say "$VIDEO present" || svc_say "no $VIDEO"
    [ -f "$LEGACY_PIDFILE" ] && svc_warn "a pre-s6 respawn loop is still around ($LEGACY_PIDFILE)"
    return 0
}

svc_dispatch "$@"
