# licence the PEP 639 way and needs setuptools>=77 to build, and the
# setuptools below is 75.6.0 and pinned for its own reasons. 1.3.5 carries
# every name 0.11.0 imports -- INotify(nonblocking=), fileno, add_watch,
# rm_watch, read(timeout=), Event, and each flag in WATCH_FLAGS. Nothing on
# this printer even reaches them: moonraker.conf sets
# `file_system_observer: none`, so the import is all that is asked of it.
PYPKG_INOTIFY_SIMPLE_FILE="inotify_simple-1.3.5.tar.gz"
