# sntpd -- the NTP client. THE PRINTER HAS NO RTC AND NO BATTERY, so every
# boot starts at whatever the kernel calls zero and stays there until
# something asks the network. Nothing on the stock rootfs can ask: its busybox
# is v1.31.1 built WITHOUT the ntpd applet (measured -- it has date, hwclock,
# rdate and crond, and rdate is RFC 868, not NTP).
#
# sntpd rather than ntpd/chrony/OpenNTPd: it is a fork of Larry Doolittle's
# ntpclient, one small daemon with no privsep user, no chroot and no runtime
# config file to ship -- and it keeps running with the network down instead of
# exiting, which is the only behaviour that matters on a machine whose wifi
# comes up minutes after the service does.
SNTPD_VERSION="3.2"
SNTPD_SHA256="15852f86b319c52134e5ffbfa43d38fa0b755a9a8ab18e3b17dfa3e84e000763"

# moonraker-timelapse. A COMMIT, and the head of main as of 2026-08-30: the
# one tag upstream ever cut is v0.0.1 of Oct 2021, two years OLDER than this,
# so pinning "the latest release" would drop hyperlapse, the configurable
# delayed_gcode interval and the webcam-database lookup the component needs.
TIMELAPSE_VERSION="c7fff11e542b95e0e15b8bb1443cea8159ac0274"
TIMELAPSE_DATE="2023-12-16"
TIMELAPSE_SHA256="efbf24ac24309440761425c9e873772882727e5f7513c6a3fc6d04601d02ea76"

# x264 and ffmpeg, ours, for the timelapse render. FlashForge ships both, but
# its ffmpeg is --disable-everything with no hflip/vflip/transpose/rotate, so
# every rotated or flipped webcam fails to render -- see pkgs/3rdparty/ffmpeg.
#
# x264 is a SNAPSHOT because upstream cuts no releases; this is the last
# "stable" one download.videolan.org carries. X264_BUILD 157.
X264_VERSION="snapshot-20191217-2245-stable"
X264_SHA256="b2495c8f2930167d470994b1ce02b0f4bfb24b3317ba36ba7f112e9809264160"

# ffmpeg 4.x, not 5/6/7: gcc 7.2 is what this printer's ABI has a toolchain
# for, and the newer branches assume a newer compiler. 4.4.5 is the last 4.4.
FFMPEG_VERSION="4.4.5"
FFMPEG_SHA256="f9514e0d3515aee5a271283df71636e1d1ff7274b15853bcd84e144be416ab07"
