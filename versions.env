# Pinned third-party payload pieces.
#
# These are NOT vendored in the repo: bin/fetch-assets.sh downloads them into
# vendor/ (gitignored) and refuses anything whose sha256 does not match. Bump
# a version here and the next build picks it up; the old file stays cached.
#
# To bump:  edit the version -- for HelixScreen that means HELIX_FILE too,
#           which embeds it -- set the matching sha256 to SKIP, then run
#           `make vendor`. It prints the real hash to paste back over SKIP.
#           With a stale hash left in place fetch-assets.sh exits 1 instead of
#           printing anything.

MAINSAIL_VERSION="v2.18.2"
MAINSAIL_SHA256="df2ba7c301f7bfc8ac9f122741a6ba08356d679ecfa1f62f898d0337802d5de5"

# Klipper: the creator5 branch of Klipper4FlashForge/klipper -- upstream
# v0.13.0 plus the FlashForge commits the printer actually needs (see the
# fork's README-creator5.md). A COMMIT, because the branch moves; bump it by
# pasting the new head sha here and re-hashing.
#
# This pin is what a release ships. KLIPPER_FORK in config.env still points
# the build at a local checkout instead -- for working on the fork itself --
# but when it is unset, bin/patch.sh extracts this tarball and builds
# c_helper.so from ITS sources with the pinned toolchain below, so the .so
# can never be older than the klippy tree beside it. The v20260824 release
# shipped without any of this: KLIPPER_FORK was empty in CI, patch.sh
# silently kept the stock 0.12-era tree, and the package half-overwrote the
# fork on updated printers -- klippy died at connect with a cffi arg-count
# error. patch.sh now refuses to build a fork package without a fork.
KLIPPER_VERSION="b722a4c8b1aedfb939a7688a9b30e7864fddd505"
KLIPPER_SHA256="dbd81ad75701a56562708a398be9efda1cfa9af84211445e5c86f0683c2326e4"

# The cross-toolchain that builds c_helper.so: Ingenic's gcc 7.2.0 /
# glibc 2.29 for the X2000 (mips32r2, little-endian, o32, nan2008 -- the
# printer's kernel refuses anything else, and Debian's mips cross-compilers
# produce big-endian or legacy-nan objects). The same toolchain the K1
# community uses for the identical SoC family; mirrored as a release asset
# by ballaswag/k1-discovery. ~203MB, so fetch-assets.sh only pulls it when
# the build actually needs to compile chelper.
MIPS_TOOLCHAIN_VERSION="1.0.0"
MIPS_TOOLCHAIN_FILE="mips-gcc720-glibc229.tar.gz"
MIPS_TOOLCHAIN_SHA256="c0415a857c6b384820ec61b8a30c89e528585f3ef07d580fc856e80313c9d2e8"

HELIX_VERSION="v0.99.115-creator5.1"
HELIX_FILE="helixscreen-creator5-v0.99.115.tar.gz"
HELIX_SHA256="7205738ca8ccb0aa9a95262506a87283712ab5544ce4abdbcbee571f51395a61"

# Moonraker. The stock one is a 2022 build (API 1.0.5) that predates the
# webcam "enabled" flag that modern Mainsail requires -- see bin/patch.sh.
#
# A COMMIT, NOT A RELEASE, and not a matter of taste. FlashForge built python
# 3.8.2 WITHOUT the _sqlite3 module and shipped no libsqlite3 anywhere on the
# printer, so every Moonraker from v0.9.0 onward dies at startup with
# "ModuleNotFoundError: No module named '_sqlite3'" -- v0.9.0 is where the
# database moved from lmdb to sqlite. The last release that still uses lmdb is
# v0.8.0, and that one predates the webcam flag. No release has both, so this
# pins the newest commit that has the webcam fix and still uses lmdb: 9d0d09d,
# 2023-12-05, the commit before 80c7620 "database: migrate from lmdb to
# sqlite". lmdb 1.3.0 is installed, so the existing database is read in place
# and nothing is converted.
#
# Before moving this pin: the blocker is native modules, not the python
# version (Moonraker still supports >=3.7). Check every dependency of a newer
# build against what is actually in Python-3.8.2/lib/python3.8/lib-dynload and
# site-packages on the factory image -- a missing C extension is fatal and a
# pure-python one is not.
#
# CHECK IT BEFORE YOU SHIP IT. Nothing on the printer checks this any more and
# there is no stock build to fall back to: the installer replaces Moonraker
# unconditionally, so a pin the interpreter cannot load leaves the machine
# without a web UI until the next flash. `make test-moonraker` is where that is
# caught -- it imports every configured component on the printer's own
# interpreter, in the replica, before anything ships.
MOONRAKER_VERSION="9d0d09de8063922696359c1b88c86a86d6fdb296"
MOONRAKER_SHA256="6ddcba08a1a41f173fc6ee393a24e41f27b25f079e7c49921b87273ecff595a8"

# ---------------------------------------------------------------- s6
# The process supervisor. skalibs is s6's own C library and is a BUILD
# dependency only -- its headers and .a are used to link s6 and are never
# shipped -- so the two are pinned together and bumped together: skarnet
# releases them as a matched set and s6 will not build against a skalibs from
# a different generation. execline is deliberately absent: s6 `run` scripts
# are plain `#!/bin/sh`, and execline would be another 53 binaries / 2.1MB
# for nothing.
#
# THREE things about this build are load-bearing, all of them measured on the
# replica rather than reasoned about (see tools/supervisor/README.md):
#
#   * It is configured --prefix=/usr/data/anvil, because s6 bakes its
#     libexecdir in AT COMPILE TIME: every waiting verb (s6-svc -w,
#     s6-svwait) execs s6-svlisten, which spawns s6-ftrigrd from that baked-in
#     path. Built for any other prefix, `s6-svstat` and respawn keep working
#     and only the waiting verbs fail -- so it fails late and partially, which
#     is the worst way for a supervisor to fail. Moving $MODDIR means
#     rebuilding s6.
#   * It is compiled with -D_FILE_OFFSET_BITS=64. Without it readdir()
#     returns EOVERFLOW on this box (32-bit build, 64-bit inodes) and
#     s6-svscan cannot see its own service directory: it starts cleanly and
#     then supervises nothing.
#   * It is linked against musl, statically. Static glibc produced a 73MB
#     tree here; musl produces 3.6MB, of which we ship ~930KB.
SKALIBS_VERSION="2.15.1.0"
SKALIBS_SHA256="f9c905e74935c6fe911c7e344e3e89d5fbd2014c1a04650b524b15ce9b5635d1"
S6_VERSION="2.15.1.0"
S6_SHA256="eab9c46e22b66b16135f9a05ec68a0ea287d9060b84d10defaaa2caad158ab52"

# The musl cross-toolchain that builds s6: mipsel-linux-musl from musl.cc.
# NOT the Ingenic toolchain above -- that one is glibc, and glibc is what
# makes a static s6 73MB. Two toolchains is not duplication: c_helper.so is a
# shared object dlopen'd by the printer's own glibc python and must match it,
# while s6 is a set of standalone static binaries that must match nothing.
#
# musl.cc publishes this at a single unversioned URL that it rebuilds in
# place, so the sha256 IS the pin -- there is no version string to bump. If
# upstream rebuilds, fetch-assets.sh fails loudly on the hash rather than
# quietly building s6 with a different compiler; re-hash it deliberately and
# re-run the case-supervisor gate before pasting a new value here.
#
# ~100MB, so fetch-assets.sh only pulls it when the s6 build actually needs
# to compile -- work/.s6 caches the built tree between runs.
MUSL_TOOLCHAIN_FILE="mipsel-linux-musl-cross.tgz"
MUSL_TOOLCHAIN_SHA256="82626533bf7e677c225e7cbedf1d5b0d6bc60c3daaf28249e54f0eb805d89b13"

# ---------------------------------------------------------------- CPython
# A SECOND Python for the printer, cross-compiled here and SHIPPED BUT NOT
# USED (bin/patch.sh section 5c). FlashForge's own /usr/prog/Python-3.8.2 is
# still what everything runs on -- see payload/anvil-env.sh.
#
# WHY IT EXISTS AT ALL. FlashForge built 3.8.2 without _sqlite3 and shipped no
# libsqlite3 anywhere on the rootfs, which is the single fact that pins
# MOONRAKER_VERSION above to a 2023 commit: every Moonraker from v0.9.0 on
# stores its database in sqlite and dies at startup on this interpreter. An
# interpreter that can `import sqlite3` is what unpins that, and it is 3.13
# rather than a 3.8 with one module added because a from-source build costs
# the same either way. Measured on the replica: the stock 3.8.2 cannot import
# sqlite3 and this one creates a database, writes it, closes it and reads it
# back. test/integration/printer/case-python.sh is that measurement, kept.
#
# EVERY VERSION BELOW IS PINNED WITH A sha256 FOR THE SAME REASON THE REST OF
# THIS FILE IS: nothing binary is vendored, so the only thing standing between
# a source URL and code the printer executes is the hash. python.org, sqlite.org
# and skarnet are not equally trustworthy, but they are equally irrelevant once
# the hash is checked.
#
# What each pin is load-bearing for, because "bump to latest" is wrong for at
# least four of them:
#
#   PY_VERSION       The interpreter, and the ONLY version this build works
#                    for as written: cross-building CPython needs a build
#                    python of the SAME version (configure hard-errors
#                    otherwise), so patch.sh builds an x86-64 3.13.7 from this
#                    same tarball first. Bump it and both halves move
#                    together, which is why there is one variable.
#   OPENSSL_VERSION  3.0.x DELIBERATELY, not 3.1/3.2/3.5. Two things about
#                    3.0.15 are relied on and both were hit for real: `no-docs`
#                    does not exist before 3.1 (patch.sh must not pass it), and
#                    the linux-mips32 target bakes `-mips2` into its cflags,
#                    which this toolchain -- default -mfp64 -- rejects unless
#                    an explicit -mips32r2 lands after it on the command line.
#                    3.0 is also the LTS branch (security fixes to 2026-09).
#                    Moving to 3.5 means re-deriving the target flags.
#   SQLITE_*         THE reason the whole build exists. The amalgamation
#                    ("autoconf") tarball, not the source tree: one .c file, no
#                    tcl, no fossil. Note the URL carries a YEAR directory that
#                    does not appear in the version number, hence SQLITE_YEAR.
#   ZLIB_VERSION     zlib.net serves current releases from /fossils/ once they
#                    are superseded, so the URL below is the stable one for an
#                    old version as well as a current one. Needed by the zlib
#                    module and by OpenSSL's compression.
#   LIBFFI_VERSION   _ctypes. Nothing on the rootfs can stand in: it ships
#                    libffi.so.7 and FlashForge's own /usr/prog carries .so.8,
#                    which is exactly the mess a static libffi.a avoids.
#   XZ_VERSION       lzma. 5.4.7 and not 5.6.x ON PURPOSE: 5.6.0/5.6.1 are the
#                    backdoored releases (CVE-2024-3094). 5.4.7 is the
#                    maintained branch that never carried it.
#   BZIP2_VERSION    bz2. Last release was 2019; this is not a stale pin, it is
#                    the whole project.
#   EXPAT_*          pyexpat, and with it every stdlib XML parser. Built here
#                    rather than left to CPython's bundled copy so there is one
#                    expat to patch when the next parser CVE lands. The tag has
#                    its own spelling (R_2_6_4) because libexpat's git tags use
#                    underscores; both appear in the URL.
#
# IF ONE OF THESE MOVES AND THE HASH IS NOT UPDATED, fetch-assets.sh stops the
# build. If a hash is updated without re-running the gate, the failure is
# silent and lands on a printer: a dependency that quietly stops linking makes
# CPython record the module as "missing" rather than fail, which is precisely
# how _sqlite3 disappeared during the spike. `make test-python` is the check.
PY_VERSION="3.13.7"
PY_SHA256="6c9d80839cfa20024f34d9a6dd31ae2a9cd97ff5e980e969209746037a5153b2"
OPENSSL_VERSION="3.0.15"
OPENSSL_SHA256="23c666d0edf20f14249b3d8f0368acaee9ab585b09e1de82107c66e1f3ec9533"
SQLITE_VERSION="3460100"
SQLITE_YEAR="2024"
SQLITE_SHA256="67d3fe6d268e6eaddcae3727fce58fcc8e9c53869bdd07a0c61e38ddf2965071"
ZLIB_VERSION="1.3.1"
ZLIB_SHA256="9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
LIBFFI_VERSION="3.4.6"
LIBFFI_SHA256="b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e"
XZ_VERSION="5.4.7"
XZ_SHA256="8db6664c48ca07908b92baedcfe7f3ba23f49ef2476864518ab5db6723836e71"
BZIP2_VERSION="1.0.8"
BZIP2_SHA256="ab5a03176ee106d3f0fa90e381da478ddae405918153cca248e682cd0c4a2269"
EXPAT_VERSION="2.6.4"
EXPAT_TAG="R_2_6_4"
EXPAT_SHA256="fd03b7172b3bd7427a3e7a812063f74754f24542429b634e0db6511b53fb2278"
