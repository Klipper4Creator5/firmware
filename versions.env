# Host-side PEP 517 backends. THESE NEVER SHIP: pkg_pywheel builds with
# --no-build-isolation, so each must already be in work/.py-host.
# ORDER IS INSTALL ORDER: pkg_buildpython pip-installs each with --no-deps
# against no index, so a backend must come after whatever builds it. flit-core
# builds packaging; setuptools_scm imports packaging at build time.
PYPKG_HOST_LIST="flit-core poetry-core packaging setuptools-scm"
PYPKG_FLIT_CORE_FILE="flit_core-3.10.1.tar.gz"         # jinja2's backend
