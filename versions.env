# site-packages: the closure of what the ENABLED Moonraker components and
# klippy import, not moonraker-requirements.txt. Sdists only -- a manylinux
# wheel is somebody else's x86-64 build. The FILE carries the version.
PYPKG_LIST="distro inotify-simple libnacl dbus-fast preprocess-cancellation
            pyserial pycparser smart-open jinja2 setuptools zipp
            importlib-metadata tornado markupsafe cffi greenlet lmdb
            streaming-form-data pillow"

