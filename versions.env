# CPython: a second interpreter, cross-built here and SHIPPED -- $FF_PYTHON
# names it, so Moonraker and klippy run on it. Exists because 3.8.2 has no
# _sqlite3. "Bump to latest" is wrong for four of these:
#   PY_VERSION       configure needs a build python of the SAME version, which
#                    payload.sh builds from this same tarball.
#   OPENSSL_VERSION  3.0.x: no-docs postdates it, and linux-mips32's -mips2
#                    needs -mips32r2 after it. 3.5 means re-deriving the flags.
#   SQLITE_*         amalgamation tarball; its URL carries SQLITE_YEAR.
#   XZ_VERSION       not 5.6.x -- 5.6.0/5.6.1 are CVE-2024-3094.
#   EXPAT_TAG        libexpat tags with underscores; both spellings in the URL.
PY_VERSION="3.13.7"
PY_SHA256="6c9d80839cfa20024f34d9a6dd31ae2a9cd97ff5e980e969209746037a5153b2"
OPENSSL_VERSION="3.0.15"
OPENSSL_SHA256="23c666d0edf20f14249b3d8f0368acaee9ab585b09e1de82107c66e1f3ec9533"
SQLITE_VERSION="3460100"
SQLITE_YEAR="2024"
SQLITE_SHA256="67d3fe6d268e6eaddcae3727fce58fcc8e9c53869bdd07a0c61e38ddf2965071"
ZLIB_VERSION="1.3.1"
ZLIB_SHA256="9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23"
LIBFFI_VERSION="3.4.6"
LIBFFI_SHA256="b0dea9df23c863a7a50e825440f3ebffabd65df1497108e5d437747843895a4e"
XZ_VERSION="5.4.7"
XZ_SHA256="8db6664c48ca07908b92baedcfe7f3ba23f49ef2476864518ab5db6723836e71"
BZIP2_VERSION="1.0.8"
