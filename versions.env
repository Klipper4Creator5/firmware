# Moonraker: a RELEASE TAG, not a commit. The old pin was the last commit
# before 80c7620 moved the database from lmdb to sqlite, because 3.8.2 has no
# _sqlite3 -- and this repo now builds and ships its own CPython, which does.
#
# /archive/<ref> takes the tag, but GitHub strips the leading "v" from the
# directory inside the tarball, which is why pkgs/moonraker/build.sh reaches
# for moonraker-${MOONRAKER_VERSION#v}.
#
# LMDB STILL SHIPS. Moonraker converts an existing data.mdb to sqlite on first
# start and imports lmdb to read it; with the module missing it tries to pip
# install one, which on a printer with no index means the old database is
# silently dropped. It is the upgrade path, not a runtime dependency.
#
# Nothing on the printer falls back to a stock build, so gate a bump on
# `make qa-replica`.
MOONRAKER_VERSION="v0.11.0"
MOONRAKER_SHA256="bba9042e9fc904b30cd46690320fec2bffe27c4458b539db65560582c6318ab3"

# s6: a matched set that will not build across generations, so all four bump
