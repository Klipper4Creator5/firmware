# STAGE 2 -- ssh + Mainsail/Moonraker.
#
# Enables the web stack that already ships on stock but is commented out.
# Klipper stays stock, so printing behaviour is unchanged.
PROFILE_DESC="stage 2: ssh + Mainsail/Moonraker, stock Klipper"

MOD_REPORT=1
