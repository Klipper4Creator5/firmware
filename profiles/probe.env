# STAGE 0 -- the first thing you should ever flash.
#
# Changes NOTHING on the printer. It reinstalls the stock software component
# byte-for-byte and adds one extra step: write a diagnostic report to the USB
# stick, then reboot.
#
# Purpose: prove the whole chain works on YOUR machine -- the filename glob,
# the DES3 key, the md5 gate, run.sh execution -- and learn the real partition
# sizes BEFORE you commit to a package that modifies anything.
#
# Pull the stick afterwards and read anvil-report.txt.
PROFILE_DESC="stage 0: no changes, writes a diagnostic report to the USB stick"

MOD_REPORT=1          # write the report
MOD_APPLY=0           # master switch: change nothing at all

MOD_KLIPPER=stock
MOD_TOOLCHANGE=0
MOD_MAINSAIL=0
MOD_HELIX=0
MOD_SSH=0
MOD_WEB=0
ROOT_PW_HASH=""
