# STAGE 4 -- HelixScreen replaces the stock touchscreen UI.
#
# This is the first profile where FlashForge's firmwareExe is no longer the
# UI. It is kept ON DISK as a fallback: the firmwareExe wrapper reverts to it
# if HelixScreen crashes, and S80ui latches SAFE-MODE after 3 failed boots.
#
# Do not flash this until stage 2 (web) has come back clean, because once the
# stock UI is not driving the screen, ssh and Mainsail ARE your recovery path.
PROFILE_DESC="stage 4: HelixScreen as the UI, stock firmwareExe kept as fallback"

BUILD_REPORT=0          # the report dumps /etc + shadow to the stick: probe only
BUILD_APPLY=1

BUILD_KLIPPER=fork
BUILD_TOOLCHANGE=1
BUILD_MAINSAIL=1
BUILD_HELIX=1
MOD_SSH=1
MOD_WEB=1
MOD_UI=helix
