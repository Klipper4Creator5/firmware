# THE DEFAULT PROFILE -- the actual firmware: everything, in one flash.
#
# Forked Klipper with toolchanger support, Mainsail/Moonraker, ssh, and
# HelixScreen driving the touchscreen in place of FlashForge's UI.
#
# Do not flash this until stage 0 (`make probe`) has come back clean on YOUR
# machine, and keep a USB stick with the STOCK FlashForge package within
# reach -- flashing that is the uninstall (proven by `make test-recovery`).
#
# FlashForge's firmwareExe is REPLACED, not kept: HelixScreen is the only UI.
# If it crash-loops, S80ui latches SAFE-MODE after 3 failed boots and the
# printer boots headless instead of looping. ssh and Mainsail are your
# recovery path if the screen is dark.
PROFILE_DESC="the firmware: forked Klipper + toolchanger + Mainsail + ssh + HelixScreen"

BUILD_REPORT=0          # the report dumps /etc + shadow to the stick: probe only
BUILD_APPLY=1

BUILD_KLIPPER=fork
BUILD_TOOLCHANGE=1
BUILD_MAINSAIL=1
BUILD_HELIX=1
MOD_SSH=1
MOD_WEB=1
