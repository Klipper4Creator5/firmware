# STAGE 1 -- ssh only.
#
# Adds dropbear and the boot hook. Klipper, the touchscreen UI and the web
# stack are all left stock, so if something is wrong you still have a working
# printer AND a shell to diagnose it with.
PROFILE_DESC="stage 1: ssh only, everything else stock"

BUILD_REPORT=0          # the report dumps /etc + shadow to the stick: probe only
BUILD_APPLY=1

BUILD_KLIPPER=stock
BUILD_TOOLCHANGE=0
BUILD_MAINSAIL=0
BUILD_HELIX=0
MOD_SSH=1
MOD_WEB=0
