# STAGE 3 -- everything: forked Klipper, toolchanger, HelixScreen.
#
# This is the only profile that replaces the Klipper tree. Do not flash it
# until stages 0-2 have come back clean on your machine, and keep the
# uninstall stick (bin/make-uninstall.sh) within reach.
PROFILE_DESC="stage 3: forked Klipper + toolchanger + Mainsail + HelixScreen"

MOD_REPORT=1
MOD_APPLY=1

MOD_KLIPPER=fork
MOD_TOOLCHANGE=1
MOD_MAINSAIL=1
MOD_HELIX=1
MOD_SSH=1
MOD_WEB=1
