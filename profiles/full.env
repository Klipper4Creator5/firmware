# STAGE 3 -- everything: forked Klipper, toolchanger, HelixScreen.
#
# This is the only profile that replaces the Klipper tree. Do not flash it
# until stages 0-2 have come back clean on your machine, and keep a USB stick
# with the STOCK FlashForge package on it within reach -- flashing that is the
# uninstall (proven by `make test-recovery`).
PROFILE_DESC="stage 3: forked Klipper + toolchanger + Mainsail + HelixScreen"

BUILD_REPORT=0          # the report dumps /etc + shadow to the stick: probe only
BUILD_APPLY=1

BUILD_KLIPPER=fork
BUILD_TOOLCHANGE=1
BUILD_MAINSAIL=1
BUILD_HELIX=1
MOD_SSH=1
MOD_WEB=1
