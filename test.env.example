# creator5-custom-firmware -- TEST configuration
#
#     cp test.env.example test.env
#
# Nothing in this file ever reaches a printer: it configures the replica and
# nothing else. Build inputs and anything that ships live in config.env.

# ---- a prebuilt replica image (START HERE) ---------------------------------
# The fastest way to run the replica tests: an image already carrying the
# printer's rootfs, its real /usr/prog and /usr/data, AND the stock package
# installed on top. A replica run then starts in under a second and PROG_DUMP
# below is not needed at all; without it every run unpacks the 182MB factory
# image (~22s) and installs the stock package under qemu (~37s) first.
#
# Built by tools/replica/build-printer-image.sh. It contains proprietary
# FlashForge firmware.
PRINTER_IMAGE="monstrofil/creator5-printer:latest"

# ---- the replica's /usr/prog and /usr/data ---------------------------------
# Only needed when PRINTER_IMAGE is empty; otherwise REQUIRED for every test
# that runs inside the replica. It is the factory image -- the genuine klipper
# daemons, nginx, python3, checkEboard, moonraker and the printer's own
# OpenSSL 1.0.2d, so package decryption is verified against the real
# implementation. There are no stubs: if this is missing the replica refuses
# to run rather than test against mocks.
#
# One image serves both models. Either take one off your own machine
#
#     ssh root@printer 'tar -cf - /usr/prog' > prog.tar
#
# or use the published factory image (md5 d2fdc0e1deb17c41cbb6016d55ab3031):
#
#     https://github.com/ghzserg/FF/releases/download/R/Creator5Pro-factory.tar.xz
PROG_DUMP="$HOME/Desktop/Creator5Pro-factory.tar.xz"

# Real partition sizes, as `df -h` reports them on the printer itself.
# Until these are set the replica's prog/data partitions are unbounded, so an
# install that runs the machine out of space would pass here and fail there.
PROG_MB=""
DATA_MB=""
