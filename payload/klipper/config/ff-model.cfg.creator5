# ---------------------------------------------------------------------------
# ff-model.cfg -- what this particular MODEL has. Creator 5 (PID 0028).
#
# One of these ships in every package. Every file that differs between models
# exists once per model with a .creator5 / .creator5pro suffix, and the build
# installs the matching one under its real name. Nothing is ever edited: the
# suffixed file IS the per-model difference, so a new model fact is a new
# variable here and nothing else has to become model-aware.
#
# REQUIRED, and it must be included BEFORE the files that read it:
#     [include ff-model.cfg]
#     [include ff-chamber.cfg]
# ---------------------------------------------------------------------------

[gcode_macro _FF_MODEL]
description: Per-model hardware facts (see models/<machine>/ff-model.cfg)
variable_machine: "Creator5"
# This machine has NO chamber heating element. printer.base.cfg still declares
# [heater_generic chamber_heater] (both models ship the same Klipper tree), so
# the object exists and can be commanded -- ff-chamber.cfg refuses it.
variable_chamber_heater: 0
gcode:
    { action_respond_info("model %s, chamber_heater=%d" % (
        printer['gcode_macro _FF_MODEL'].machine,
        printer['gcode_macro _FF_MODEL'].chamber_heater|int)) }
