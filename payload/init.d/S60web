#!/bin/sh
# nginx (Mainsail) + moonraker.
#
# Both binaries already ship on stock firmware -- FlashForge simply comments
# them out of /usr/prog/klipper/start.sh and serves its own HTTP API from
# firmwareExe instead. The mod replaces firmwareExe, so that API is gone and
# this is the only web stack on the printer.
#
# MOD_WEB=0 therefore does NOT fall back to anything: it leaves the printer
# with ssh and the touchscreen only. It is a debugging switch, not a way back
# to stock -- that is a stock FlashForge package.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
# The library path and the interpreter, from the one file that defines them.
# See anvil-env.sh for why naming them here instead was a bug.
if [ -f $MODDIR/anvil-env.sh ]; then
    . $MODDIR/anvil-env.sh
else
    echo "web: !! no $MODDIR/anvil-env.sh -- the mod payload is not installed"
fi
NGINX=/usr/prog/nginx/sbin/nginx
NGINX_PID=$MODDIR/nginx/logs/nginx.pid
MOONRAKER_PID=/run/moonraker.pid
MOONRAKER_LOG=/usr/data/logs/moonraker.log
MOONRAKER_TMP=/usr/data/tmp
MOONRAKER_DATA=/usr/data

# ONE moonraker, at one path. run-append.sh installs the mod's build here on
# every flash and does not consult the tree it replaces, so there is nothing
# for this script to choose between: whatever is here is ours.
#
# This used to fall back to $MODDIR/moonraker/moonraker.py when the installed
# tree was missing, which paired with an installer that kept FlashForge's 2022
# build whenever a pre-flight import check failed. Between them a printer
# could be running any of three moonrakers, the boot log did not say which,
# and a bug report could not be read without asking. The mod ships one
# moonraker and installs it; if it is not here, that is a failed install to be
# reported, not a condition to route around.
MOONRAKER_MAIN=/usr/prog/moonraker/moonraker/moonraker/moonraker.py

start() {
    [ "${MOD_WEB:-1}" = "1" ] || { echo "web: disabled in anvil.conf"; return 0; }
    if [ -x "$NGINX" ] && [ -f $MODDIR/nginx/nginx.conf ]; then
        mkdir -p $MODDIR/nginx/logs $MODDIR/nginx/tmp
        $NGINX -p $MODDIR/nginx -c $MODDIR/nginx/nginx.conf \
            && echo "nginx: started" || echo "nginx: FAILED"
    else
        echo "nginx: not available"
    fi

    # Every branch below says something. A web stack that is not running is a
    # printer with no UI, and the boot log is the only place that can explain
    # why -- there is no stock server left to quietly take over.
    if ! anvil_python_ok; then
        echo "moonraker: no interpreter at ${FF_PYTHON:-/usr/prog/Python-3.8.2/bin/python3} -- not started"
        return 1
    fi
    if [ ! -f "$MOONRAKER_MAIN" ]; then
        echo "moonraker: nothing at $MOONRAKER_MAIN -- the install did not complete"
        return 1
    fi

    # Start moonraker ourselves rather than through
    # /usr/prog/klipper/moonrakerDaemon. That script is FlashForge's, it is on
    # the firmware partition a stock flash overwrites, and it hardcodes an
    # interpreter and a tree we no longer want -- and every time we call it we
    # have to reconstruct the environment it does not set anyway. Doing it
    # here means one place decides which moonraker runs, with which libraries.
    #
    # The two things the daemon did for us are kept, because both matter:
    #   * start-stop-daemon writes the pidfile that `stop` uses. Without it
    #     there is no way to stop moonraker except by name.
    #   * TMPDIR. Moonraker writes temporary files -- uploads among them --
    #     and /tmp here is a ramdisk, so a large upload without this fills
    #     memory instead of the data partition.
    #
    # The wipe is guarded on moonraker not already running: re-running this
    # script over ssh against a live server would otherwise delete the
    # directory it is streaming an upload into.
    if ! moonraker_alive; then
        rm -rf $MOONRAKER_TMP
    fi
    mkdir -p $MOONRAKER_TMP
    export TMPDIR=$MOONRAKER_TMP
    mkdir -p `dirname $MOONRAKER_LOG`

    start-stop-daemon -S -b -m -p $MOONRAKER_PID \
        --exec $FF_PYTHON \
        -- $MOONRAKER_MAIN -d $MOONRAKER_DATA
    rc=$?
    if [ $rc = 0 ]; then
        echo "moonraker: started ($MOONRAKER_MAIN)"
        moonraker_check &
    else
        # start-stop-daemon exits non-zero when a process matching the pidfile
        # is already running, which after `restart` means the old one outlived
        # the wait in stop(). Either way nothing new was started, and that is
        # the thing worth printing -- it used to print nothing at all.
        echo "moonraker: FAILED to start -- start-stop-daemon returned $rc"
        return 1
    fi
}

# Did it actually come up? Moonraker failing to load a component exits
# quietly, minutes before anyone opens a browser and finds out. Say so in the
# boot log, with the reason, because "moonraker did not start" is otherwise a
# support conversation rather than a log line.
moonraker_alive() {
    [ -f "$MOONRAKER_PID" ] || return 1
    kill -0 `cat "$MOONRAKER_PID"` 2>/dev/null
}

# Component-load failures happen within seconds of exec, so a server still
# alive at 10s is up. Confirming and returning beats holding the boot log open
# for a minute: this runs in the background while S65camera, S70klipper and
# S80ui are writing to the same file, and an interleaved log is what made one
# user's boot unreadable at the point they were trying to read it.
moonraker_check() {
    waited=0
    while [ $waited -lt 5 ]; do
        sleep 2
        waited=$((waited + 1))
        moonraker_alive && continue
        echo "moonraker: NOT running after $((waited * 2))s -- last words:"
        tail -n 15 "$MOONRAKER_LOG" 2>/dev/null | sed 's/^/    /'
        return 1
    done
    echo "moonraker: up"
    return 0
}

stop() {
    [ -f "$NGINX_PID" ] && kill `cat $NGINX_PID` 2>/dev/null
    if [ -f "$MOONRAKER_PID" ]; then
        start-stop-daemon -K -p $MOONRAKER_PID 2>/dev/null
        # busybox start-stop-daemon does not remove the pidfile, and it does
        # not wait. Both matter: a stale pidfile makes `status` report a
        # recycled PID as a running moonraker, and returning before the
        # process is gone makes `restart` race its own start.
        stopping=0
        while moonraker_alive && [ $stopping -lt 15 ]; do
            sleep 1
            stopping=$((stopping + 1))
        done
        moonraker_alive && echo "moonraker: still running after ${stopping}s"
        rm -f "$MOONRAKER_PID"
    fi
    echo "web: stopped"
}

case "$1" in
    start|'') start ;;
    stop)     stop ;;
    restart)  stop; start ;;
    status)   [ -f "$NGINX_PID" ] && echo "nginx: running" || echo "nginx: not running"
              moonraker_alive && echo "moonraker: running" || echo "moonraker: not running" ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
