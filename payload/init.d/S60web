#!/bin/sh
# nginx (Mainsail) + moonraker.
#
# Both binaries already ship on stock firmware -- FlashForge simply comments
# them out of /usr/prog/klipper/start.sh and serves its own HTTP API from
# firmwareExe instead. The mod replaces firmwareExe, so that API is gone and
# this is the only web stack on the printer.
#
# MOD_WEB=0 therefore does NOT fall back to anything: it leaves the printer
# with ssh and the touchscreen only. It is a debugging switch, not a way back
# to stock -- that is a stock FlashForge package.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
NGINX=/usr/prog/nginx/sbin/nginx
NGX_PID=$MODDIR/nginx/logs/nginx.pid
MR_PID=/run/moonraker.pid
MR_LOG=/usr/data/logs/moonraker.log
MR_TMP=/usr/data/tmp
MR_DATA=/usr/data
MR_PY=/usr/prog/Python-3.8.2/bin/python3

# Which moonraker actually runs. The INSTALLED tree first: run-append.sh
# already decided what belongs there -- the mod's build if it passed the
# preflight on this printer, the stock one if it did not -- and overriding
# that decision here would defeat the rollback it exists to provide. The copy
# on the data partition is the fallback for a printer where /usr/prog has no
# moonraker at all.
MR_MAIN=/usr/prog/moonraker/moonraker/moonraker/moonraker.py
[ -f "$MR_MAIN" ] || MR_MAIN=$MODDIR/moonraker/moonraker.py

start() {
    [ "${MOD_WEB:-1}" = "1" ] || { echo "web: disabled in anvil.conf"; return 0; }
    if [ -x "$NGINX" ] && [ -f $MODDIR/nginx/nginx.conf ]; then
        mkdir -p $MODDIR/nginx/logs $MODDIR/nginx/tmp
        $NGINX -p $MODDIR/nginx -c $MODDIR/nginx/nginx.conf \
            && echo "nginx: started" || echo "nginx: FAILED"
    else
        echo "nginx: not available"
    fi
    if [ -x "$MR_PY" ]; then
        # This interpreter does not start without its own libraries on the
        # path: without them python3 dies on "libpython3.8.so.1.0: cannot
        # open shared object file", moonraker never listens on 7125, and
        # every UI reports a connection timeout. That is how moonrakerDaemon
        # shipped broken once -- on stock it is only ever called from
        # klipper/start.sh, which exports these first.
        #
        # libsodium is the fourth for a reason: moonraker's `authorization`
        # component is linked against it through PyNaCl, and without it
        # moonraker does not fail to import -- it exits during component
        # load, which from outside is indistinguishable from never having
        # started. app_startup.sh does export it before running the wrapper,
        # so on a normal boot it is inherited anyway; naming it here is what
        # makes this script work when that environment is not there, which is
        # every time somebody re-runs it over ssh.
        export PATH=$PATH:/usr/prog/Python-3.8.2/bin
        export LD_LIBRARY_PATH=/usr/prog/Python-3.8.2/lib:$LD_LIBRARY_PATH
        export LD_LIBRARY_PATH=/usr/prog/openssl-1.0.2d/lib:$LD_LIBRARY_PATH
        export LD_LIBRARY_PATH=/usr/prog/libffi-3.4.4/lib:$LD_LIBRARY_PATH
        export LD_LIBRARY_PATH=/usr/prog/libsodium/lib:$LD_LIBRARY_PATH
        # Start moonraker ourselves rather than through
        # /usr/prog/klipper/moonrakerDaemon. That script is FlashForge's, it
        # is on the firmware partition a stock flash overwrites, and it
        # hardcodes an interpreter and a tree we no longer necessarily want
        # -- and every time we call it we have to reconstruct the environment
        # it does not set anyway. Doing it here means one place decides which
        # moonraker runs, with which libraries.
        #
        # The two things the daemon did for us are kept, because both matter:
        #   * start-stop-daemon writes the pidfile that `stop` uses. Without
        #     it there is no way to stop moonraker except by name.
        #   * TMPDIR. Moonraker writes temporary files -- uploads among them
        #     -- and /tmp here is a ramdisk, so a large upload without this
        #     fills memory instead of the data partition.
        rm -rf $MR_TMP && mkdir -p $MR_TMP
        export TMPDIR=$MR_TMP
        if [ -f "$MR_MAIN" ]; then
            start-stop-daemon -S -b -m -p $MR_PID --exec $MR_PY \
                -- $MR_MAIN -d $MR_DATA && echo "moonraker: started ($MR_MAIN)"
            moonraker_check &
        else
            echo "moonraker: no moonraker.py found -- not started"
        fi
    fi
}

# Did it actually come up? Moonraker failing to load a component exits
# quietly, minutes before anyone opens a browser and finds out. Say so in the
# boot log, with the reason, because "moonraker did not start" is otherwise a
# support conversation rather than a log line.
moonraker_alive() {
    [ -f "$MR_PID" ] || return 1
    kill -0 `cat "$MR_PID"` 2>/dev/null
}

moonraker_check() {
    n=0
    while [ $n -lt 30 ]; do
        sleep 2
        n=$((n + 1))
        moonraker_alive && continue
        echo "moonraker: NOT running after $((n * 2))s -- last words:"
        tail -n 15 "$MR_LOG" 2>/dev/null | sed 's/^/    /'
        return 1
    done
    echo "moonraker: up"
    return 0
}
stop() {
    [ -f "$NGX_PID" ] && kill `cat $NGX_PID` 2>/dev/null
    [ -f "$MR_PID" ] && start-stop-daemon -K -p $MR_PID 2>/dev/null
    echo "web: stopped"
}
case "$1" in
    start|'') start ;;
    stop)     stop ;;
    restart)  stop; sleep 2; start ;;
    status)   [ -f "$NGX_PID" ] && echo "nginx: running" || echo "nginx: not running"
              moonraker_alive && echo "moonraker: running" || echo "moonraker: not running" ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
