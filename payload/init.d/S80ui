#!/bin/sh
# Decide WHETHER the UI should run, and record the verdict in $MODDIR/.ui-choice
# for the firmwareExe wrapper to act on.
#
# The decision is separated from the launching because the UI must run in the
# FOREGROUND of the firmwareExe wrapper (so app_startup.sh's `ps | grep
# firmwareExe` watchdog sees a live process). An init script cannot hold that
# foreground, so it only chooses.
#
# That is also why this script uses none of anvil-service.sh's daemon helpers:
# there is no daemon here, no pidfile and nothing to supervise. It takes the
# common shape -- svc_say, svc_warn, svc_dispatch -- and nothing else.
#
# HelixScreen is the only UI: FlashForge's firmwareExe is retired and there is
# nothing to fall back to. There is no crash counter and no automatic headless
# latch -- the UI is started whenever it is installed and MOD_UI is not 0.
# To stop it, set MOD_UI=0 in /usr/data/anvil/anvil.conf and reboot; ssh comes
# from the stock /etc/init.d/S50dropbear, which busybox init ran long before
# this script, so it is up regardless of what happens here, and so are
# S60nginx/S62moonraker (Mainsail) and S70klipper.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
# start/stop/status/liveness, shared with the other services. See
# anvil-service.sh for the whole API.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "ui: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=ui

CHOICE=$MODDIR/.ui-choice

have_helix() { [ -x $MODDIR/helixscreen/bin/helix-launcher.sh ] || [ -x $MODDIR/helixscreen/bin/helix-screen ]; }

start() {
    want=helix

    if [ "${MOD_UI:-1}" = 0 ]; then
        svc_say "MOD_UI=0 in anvil.conf -- staying headless"
        want=none
    fi

    if [ "$want" = helix ] && ! have_helix; then
        svc_say "HelixScreen is not installed -- staying headless"
        want=none
    fi
    if [ "$want" = none ]; then
        svc_warn "printer will be headless -- no UI on the screen"
        # A continuation of the line above, so it is indented rather than
        # prefixed: the "ui: !!" that somebody greps for is on the warning.
        echo "    ssh is still up via /etc/init.d/S50dropbear, and so is Mainsail"
    fi

    echo "$want" > "$CHOICE"
    svc_say "chose $want"
}

stop() {
    killall helix-screen helix-watchdog helix-splash 2>/dev/null
    svc_say "stopped"
}

status() {
    svc_say "choice: `cat $CHOICE 2>/dev/null || echo unset`"
    svc_say "MOD_UI: ${MOD_UI:-1}"
}

svc_dispatch "$@"
