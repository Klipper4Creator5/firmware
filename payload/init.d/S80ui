#!/bin/sh
# Decide WHETHER the UI should run, and record the verdict in $MODDIR/.ui-choice
# for the firmwareExe wrapper to act on.
#
# The decision is separated from the launching because the UI must run in the
# FOREGROUND of the firmwareExe wrapper (so app_startup.sh's `ps | grep
# firmwareExe` watchdog sees a live process). An init script cannot hold that
# foreground, so it only chooses.
#
# HelixScreen is the only UI: FlashForge's firmwareExe is retired and there is
# nothing to fall back to. There is no crash counter and no automatic headless
# latch -- the UI is started whenever it is installed and MOD_UI is not 0.
# To stop it, set MOD_UI=0 in /usr/data/anvil/anvil.conf and reboot; ssh comes
# from the stock /etc/init.d/S50dropbear, which busybox init ran long before
# this script, so it is up regardless of what happens here, and so are S60web
# (Mainsail) and S70klipper.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
CHOICE=$MODDIR/.ui-choice

have_helix() { [ -x $MODDIR/helixscreen/bin/helix-launcher.sh ] || [ -x $MODDIR/helixscreen/bin/helix-screen ]; }

start() {
    want=helix

    if [ "${MOD_UI:-1}" = 0 ]; then
        echo "ui: MOD_UI=0 in anvil.conf -- staying headless"
        want=none
    fi

    if [ "$want" = helix ] && ! have_helix; then
        echo "ui: HelixScreen is not installed -- staying headless"
        want=none
    fi
    if [ "$want" = none ]; then
        echo "ui: WARNING printer will be headless -- no UI on the screen"
        echo "    ssh is still up via /etc/init.d/S50dropbear, and so is Mainsail"
    fi

    echo "$want" > "$CHOICE"
    echo "ui: chose $want"
}
stop() {
    killall helix-screen helix-watchdog helix-splash 2>/dev/null
    echo "ui: stopped"
}
case "$1" in
    start|'') start ;;
    stop)     stop ;;
    restart)  stop; sleep 2; start ;;
    status)   echo "ui choice: `cat $CHOICE 2>/dev/null || echo unset`";
              echo "MOD_UI:    ${MOD_UI:-1}" ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
