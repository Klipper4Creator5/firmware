#!/bin/sh
# Camera -- mjpg-streamer on :8080.
#
# WHY THIS EXISTS -- the same trap as WiFi. /usr/prog/mjpg-streamer ships on
# stock firmware (mjpg_streamer, input_uvc.so, output_http.so, its own
# libjpeg.so.9 and a www/ dir), and app_startup.sh only ever exports
# LD_LIBRARY_PATH for it -- it never launches it. firmwareExe did, and in fact
# served the stream from its own OpenCV capture, labelling itself
# "Server: MJPG-Streamer/0.2". So the moment the mod replaces firmwareExe the
# camera goes dark, with a perfectly good streamer sitting unused on the disk.
#
# Nothing has to be built or shipped for this: we start the binary FlashForge
# already put there. Mainsail then finds it through the [webcam] entry in
# moonraker.conf, which points at nginx's /webcam/ proxy rather than :8080
# directly, so a tunnel that forwards one port still shows the stream.
#
# LD_LIBRARY_PATH matters: libjpeg.so.9 lives in the mjpg-streamer directory
# itself, so without it the binary dies on a missing shared object -- the same
# failure moonrakerDaemon has in S62moonraker. The plugin names are resolved
# relative to the working directory, hence the cd.
#
# That one directory is prepended here rather than in anvil-env.sh, which
# carries the shared list: it is a plugin directory with its own libjpeg, and
# putting it in front of every python process on the printer would risk a
# version conflict to benefit one service.
#
# LIKE S50wifi, IT MUST NOT MAKE THE BOOT WAIT. The USB camera can take a few
# seconds to enumerate, and a printer with no camera plugged in would otherwise
# hold up Klipper and the UI for the full timeout. The wait and the respawn
# loop live in a background subshell; start() returns at once. That is
# svc_detach -- see anvil-service.sh.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
[ -f $MODDIR/anvil-env.sh ] && . $MODDIR/anvil-env.sh
# start/stop/status/liveness, shared with the other services. See
# anvil-service.sh for the whole API.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "camera: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=camera

CAMDIR=/usr/prog/mjpg-streamer
VIDEO=/dev/video0
PIDFILE=$MODDIR/mjpg.pid
LOG=/usr/data/logs/mjpg.log
RES="${MOD_CAM_RES:-1280x720}"
FPS="${MOD_CAM_FPS:-30}"
PORT="${MOD_CAM_PORT:-8080}"

# The streamer is started by the supervisor below, not by start-stop-daemon,
# and it is replaced by a new pid on every respawn -- so the pidfile holds the
# SUPERVISOR and the streamer itself can only be asked after by name.
streamer_running() {
    svc_proc_alive mjpg_streamer
}

# The part that waits. Detached from the boot sequence, so nothing reads its
# exit code -- it reports through the boot log only.
supervise() {
    waited=0
    while [ ! -e "$VIDEO" ] && [ $waited -lt 30 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    if [ ! -e "$VIDEO" ]; then
        svc_warn "$VIDEO never appeared -- no camera plugged in?"
        return 1
    fi

    mkdir -p /usr/data/logs
    export LD_LIBRARY_PATH=$CAMDIR:$LD_LIBRARY_PATH
    cd "$CAMDIR" || return 1

    # Respawn: a USB camera that is unplugged and replugged takes the streamer
    # down with it, and there is no other supervisor on this box.
    # NICE_CAM (anvil.conf) yields the streamer to klippy. Not svc_start_daemon's
    # -N here: this one is started by the supervisor above, not by
    # start-stop-daemon, so it takes the `nice` applet instead. Re-applied on
    # every respawn because each iteration is a fresh process. `nice` execs in
    # place, so the pid the supervisor waits on is still the streamer's.
    while true; do
        nice -n "${NICE_CAM:-0}" ./mjpg_streamer \
            -i "input_uvc.so -d $VIDEO -r $RES -f $FPS" \
            -o "output_http.so -p $PORT -w www" \
            >>"$LOG" 2>&1
        sleep 3
    done
}

start() {
    if [ "${MOD_CAM:-1}" != "1" ]; then
        svc_say "disabled by MOD_CAM"
        return 0
    fi
    [ -x "$CAMDIR/mjpg_streamer" ] || { svc_warn "no $CAMDIR/mjpg_streamer"; return 1; }
    if streamer_running; then
        svc_say "mjpg_streamer already running"
        return 0
    fi

    # svc_detach leaves the supervisor's pid in SVC_BG_PID, and it is written
    # to the pidfile because the supervisor is the half of this that has to be
    # killable: see stop().
    svc_detach supervise
    echo "$SVC_BG_PID" > "$PIDFILE"
    svc_say "waiting for $VIDEO in the background (:$PORT, $RES @ ${FPS}fps)"
    return 0
}

stop() {
    # The supervisor first: kill only the streamer and it is restarted in 3s.
    # svc_stop_daemon signals the pid in the pidfile, waits for it to actually
    # be gone, and removes the file -- so by the time the killall below runs,
    # nothing is left that would respawn what it kills.
    svc_stop_daemon "$PIDFILE"
    killall mjpg_streamer 2>/dev/null
    # And wait for the streamer itself, for the same reason `restart` no longer
    # has a `sleep 2` in front of it: killall returns as soon as the signal is
    # sent, and a start() that ran a moment later would see the dying process,
    # say "already running", and leave the camera dark.
    waited=0
    while streamer_running && [ $waited -lt 15 ]; do
        sleep 1
        waited=$((waited + 1))
    done
    streamer_running && svc_warn "mjpg_streamer still running after ${waited}s"
    svc_say "stopped"
}

status() {
    streamer_running && svc_say "mjpg_streamer running on :$PORT" \
                     || svc_say "not running"
    [ -e "$VIDEO" ] && svc_say "$VIDEO present" || svc_say "no $VIDEO"
}

svc_dispatch "$@"
