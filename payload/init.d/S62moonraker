#!/bin/sh
# moonraker -- the API on :7125 that Mainsail and HelixScreen both talk to.
#
# It already ships on stock firmware -- FlashForge simply comments it out of
# /usr/prog/klipper/start.sh and serves its own HTTP API from firmwareExe
# instead. The mod replaces firmwareExe, so that API is gone: this is the only
# thing on the printer that can answer a UI, and a printer whose moonraker is
# not running is a printer with no UI at all, however healthy klippy is.
#
# THIS AND S60nginx WERE ONE SCRIPT, S60web -- see the header there for why
# they are two now, and why the numbering has to keep this one after S60nginx
# and before S65camera.
#
# MOD_WEB=0 gates both scripts. It does not fall back to anything; it is a
# debugging switch, not a way back to stock.
#
# WHAT CHANGED WHEN s6 ARRIVED, and what deliberately did not. moonraker is now
# a supervised service: $MODDIR/etc/s6/moonraker/ holds a `run` script,
# s6-supervise runs it, and when moonraker dies s6 starts it again. That is the
# whole point -- before this, a server that fell over stayed fallen until
# somebody noticed the UI was dead and ssh'd in, and this script had no way to
# do anything about it because a shell that has returned cannot restart
# anything. Three pieces of hand-rolled machinery went with it:
#
#   the pidfile        ->  s6-svstat, asked of the supervisor. /run/moonraker.pid
#                          is no longer written by anything; it survives below
#                          only as the upgrade path, see stop().
#   moonraker_check    ->  a real READINESS notification. The old check slept
#                          two seconds five times and called the service "up"
#                          if the pid was still there; the run script now
#                          notifies s6 when the API is LISTENING, and the
#                          detached reporter below blocks on that. See the long
#                          note in etc/s6/moonraker/run for why "listening" is
#                          the right definition and "klippy is ready" is not.
#   stop-and-wait      ->  s6-svc -wD -d, which marks the service down BEFORE
#                          signalling it and returns only when it is gone.
#
# THE INTERFACE IS UNCHANGED, on purpose. `S62moonraker restart` over ssh -- the
# one you type over and over while chasing a moonraker config -- is in the docs
# and in people's hands, and changing the supervisor is not a reason to change
# what people type. start/stop/restart/status all still exist, still say
# "moonraker: ...", and still mean what they meant.
#
# WHERE THE MOD_WEB GATE LIVES NOW. In this file, exactly as before, and NOT in
# the scandir -- $MODDIR/etc/s6/moonraker/down ships in the payload precisely so
# that the scanner never makes that decision. anvil.conf is read at runtime and
# the payload is built once; the long version of that argument is written in
# the `down` file itself, next to the thing it explains.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
# The library path and the interpreter, from the one file that defines them.
# See anvil-env.sh for why naming them here instead was a bug: this is the
# script that had its own four-directory copy of the list while the installer
# checked with ten, and moonraker is the process that dies on
# "libpython3.8.so.1.0: cannot open shared object file" when it is wrong.
if [ -f $MODDIR/anvil-env.sh ]; then
    . $MODDIR/anvil-env.sh
else
    echo "moonraker: !! no $MODDIR/anvil-env.sh -- the mod payload is not installed"
fi
# start/stop/status/liveness, shared with the other services. See
# anvil-service.sh for the whole API -- including the svc_s6_* helpers, which
# are what the verbs below are built out of.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "moonraker: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=moonraker

MOONRAKER_LOG=/usr/data/logs/moonraker.log
MOONRAKER_TMP=/usr/data/tmp
MOONRAKER_DATA=/usr/data

# THE PIDFILE THE OLD SCRIPT WROTE. Nothing here writes it any more -- the
# supervised service is identified by s6-svstat and the fallback path below
# writes it only on a printer that has no supervisor at all. It is named
# unconditionally because stop() has to be able to clean up after a payload
# that DID write it: see the comment there. Same shape, same reason, as
# S65camera's LEGACY_PIDFILE.
MOONRAKER_PID=/run/moonraker.pid

# ONE moonraker, at one path, and that path is on the DATA partition.
#
# bin/patch.sh stages Moonraker's python package straight into the payload
# (`cp -a work/.moonraker/moonraker "$MOD_PAYLOAD/moonraker"`), so the tarball
# the installer extracts already puts the entry point here. Nothing else has to
# happen for this to exist, and if it does not exist the install did not
# complete.
#
# It used to run from /usr/prog/moonraker/moonraker/moonraker/moonraker.py --
# a byte-identical SECOND copy of this same tree that run-append.sh made after
# extracting the first one. That copy is gone, and the reasons it seemed
# necessary did not survive being checked:
#
#   * /usr/prog is the small firmware partition, and it is what a stock
#     FlashForge flash overwrites. Running from there meant that flashing stock
#     firmware silently reverted Moonraker to FlashForge's 2022 build while the
#     rest of the mod -- which lives on /usr/data and survives -- carried on
#     assuming the new one. That is the "which moonraker is this printer
#     actually running?" ambiguity we spent a release removing, reintroduced by
#     the one file nobody looked at.
#   * The moonraker-env virtualenv sitting beside it is unused. Imports resolve
#     from /usr/prog/Python-3.8.2/lib/python3.8/site-packages instead --
#     verified by running the printer's own interpreter on the real image,
#     where moonraker-env is not on sys.path at all.
#   * moonrakerDaemon, the one thing that did name the /usr/prog tree by
#     absolute path, is never invoked: this script starts moonraker itself.
#
# There is no fallback here and there must not be one. The mod ships exactly
# one moonraker and installs it; if it is not at this path, that is a failed
# install to be reported, not a condition to route around. The `run` script
# names the same path, and the two must not drift.
MOONRAKER_MAIN=$MODDIR/moonraker/moonraker.py

# The service directory the scanner watches, spelled out of the two variables
# anvil-service.sh defines so that this script and S40s6 cannot disagree about
# where the scandir is. S6NAME is a separate variable from SVC_NAME even though
# the two are spelled the same today: SVC_NAME is what this script calls itself
# in the log, S6NAME is what s6 calls the thing it supervises, and keeping them
# apart is what stops a future rename of one silently renaming the other.
S6NAME=moonraker
SVCDIR=$SVC_S6_SCANDIR/$S6NAME

# Is there a live s6-supervise for our service directory RIGHT NOW?
#
# Two separate questions hide in "is s6 there", and both have to be yes before
# any of the verbs below can use it. svc_s6_running answers the first -- is the
# SCANNER alive and listening -- and does it by behaviour, by pinging the
# control FIFO. This answers the second: has that scanner actually picked our
# directory up and started a supervisor for it? A scandir the scanner has not
# read yet (the payload was extracted after S40s6 ran; somebody dropped the
# directory in by hand) looks exactly like a scandir with no moonraker in it,
# and `s6-svc` against it fails with "supervisor not running" -- a true
# statement about a state that fixes itself the moment the scanner rescans.
#
# s6-svok is that question in one syscall: it opens the supervise/control FIFO
# and exits 0 only if a supervisor has it open at the other end. Same technique
# as svc_s6_running, one level down, and the same reason for preferring it to a
# test for the directory: a servicedir on disk with no supervisor behind it is
# the stale-pidfile lie all over again.
supervised() {
    [ -x "$SVC_S6_BIN/s6-svok" ] || return 1
    "$SVC_S6_BIN/s6-svok" "$SVCDIR"
}

# Ask the scanner to pick up the service directory, then wait a moment for the
# supervisor to appear. svc_s6_running IS the rescan request -- `s6-svscanctl
# -a` is what it pings with -- so this is one call doing two jobs, which is
# worth saying out loud because it does not look like it does. The bound is 5
# seconds and is only ever paid on a printer where something is already wrong:
# on a normal boot the payload was extracted long before S40s6 started the
# scanner, so the supervisor is already there and the first test succeeds.
# Anything that spends time here is spending firmwareExe's boot, one script at
# a time in the foreground, which is why it is 5 and not 30.
await_supervisor() {
    supervised && return 0
    svc_s6_running || return 1
    _mr_waited=0
    while ! supervised && [ $_mr_waited -lt 5 ]; do
        sleep 1
        _mr_waited=$((_mr_waited + 1))
    done
    unset _mr_waited
    supervised
}

# ---- the fallback, and why moonraker has one when the camera does not ------
#
# WHAT HAPPENS WHEN THERE IS NO SUPERVISOR. MOD_S6=0 is a switch S40s6 honours,
# so "no scanner" is a state a user can choose; and a payload whose s6 failed
# to build, or an install that got half way, is a state nobody chose but that
# happens anyway -- the -D_FILE_OFFSET_BITS=64 trap in
# tools/supervisor/README.md produces binaries that exec fine and then go blind
# on readdir(). The two services already migrated answered this question
# differently on purpose: S60nginx falls back to starting nginx directly,
# S65camera refuses and explains. moonraker FALLS BACK, with nginx, and the
# reason is that it is the same decision, not a second one:
#
#   * MOD_WEB IS ONE SWITCH ACROSS BOTH SCRIPTS, so "the web stack runs" and
#     "the web stack does not" are the only two states the user asked for. A
#     dead supervisor that left nginx serving and moonraker refusing would
#     invent a third one that nobody chose and that is the worst of the three
#     to be handed: Mainsail loads, connects to nothing, and blames Klipper.
#     Every minute spent debugging that is spent in the wrong subsystem.
#   * MOONRAKER IS NOT ONLY THE UI. bin/ff-startup.py -- which S70klipper hands
#     the whole boot to -- drives the panel from moonraker's API and cannot
#     learn klippy_state, report an MCU fault, or run the firmware-config
#     migration without it. Refusing here would turn a supervisor that did not
#     build into a printer that cannot bring itself up or say why, and the way
#     you would be told is the screen and the web UI that both just went away.
#     That is a strictly worse failure than the camera's, which is why the
#     camera's answer is not copied: a printer with no camera is a printer with
#     no camera, and a printer with no moonraker is a brick with a login shell.
#   * The old path is not hypothetical or unmaintained -- it is the code that
#     shipped for the whole life of this script, it is a dozen lines, and
#     case-moonraker.sh still exercises it on the no-scanner path.
#   * The classic reason NOT to fall back is that you end up with two of them:
#     a directly-started moonraker, then a scanner arriving later and starting a
#     second one on a port that is already bound. That cannot happen here, and
#     it is the `down` file that makes it so -- the scanner never starts
#     moonraker on its own, only this script does. And when this script does,
#     the `run` script sweeps any moonraker that is already running before
#     exec'ing its own, so the hand-over from the fallback to the supervised
#     copy is clean rather than a fight over :7125.
#
# What it is NOT allowed to be is silent. A printer running the fallback has
# lost automatic restart-on-crash without losing the API, which is exactly the
# kind of half-degraded state that gets discovered six months later, so it says
# so every time, with "!!", which is what people grep a boot log for.
start_unsupervised() {
    svc_warn "no supervisor -- starting moonraker directly, it will NOT be restarted if it dies"
    # The wipe is guarded on moonraker not already running: re-running this
    # script over ssh against a live server would otherwise delete the
    # directory it is streaming an upload into. (The supervised path has no
    # such guard and does not need one -- see the comment in the run script.)
    if ! svc_pid_alive "$MOONRAKER_PID"; then
        rm -rf $MOONRAKER_TMP
    fi
    mkdir -p $MOONRAKER_TMP
    export TMPDIR=$MOONRAKER_TMP
    mkdir -p `dirname $MOONRAKER_LOG`
    svc_start_daemon "$MOONRAKER_PID" "$FF_PYTHON" \
        "$MOONRAKER_MAIN" -d "$MOONRAKER_DATA" || return 1
    svc_say "started (unsupervised, $MOONRAKER_MAIN)"
    # The pre-s6 liveness check, kept whole for the path that still needs it.
    # It is a guess -- a pid that is still there is not an API that answers --
    # and it is why the supervised path has a readiness notification instead.
    svc_detach moonraker_check
}

# Component-load failures happen within seconds of exec, so a server still
# alive at 10s is up. Confirming and returning beats holding the boot log open
# for a minute: this runs in the background while S65camera, S70klipper and
# S80ui are writing to the same file, and an interleaved log is what made one
# user's boot unreadable at the point they were trying to read it.
moonraker_check() {
    waited=0
    while [ $waited -lt 5 ]; do
        sleep 2
        waited=$((waited + 1))
        svc_pid_alive "$MOONRAKER_PID" && continue
        svc_warn "NOT running after $((waited * 2))s -- last words:"
        tail -n 15 "$MOONRAKER_LOG" 2>/dev/null | sed 's/^/    /'
        return 1
    done
    svc_say "up"
    return 0
}

# The detached half of the supervised path, and the thing the whole phase was
# for. Nothing reads its exit code; it reports through the boot log only,
# exactly as moonraker_check did.
#
# svc_s6_ready blocks on s6-svwait -U, which returns when the run script writes
# to its notification-fd -- and the run script does that only once moonraker has
# BOUND :7125, not when it was forked. So the "answering" line below is true
# when it is printed, which is the entire difference between this and the old
# check that watched a pid and said "up".
#
# 120 seconds, against the run script's own 180-second probe. A caller-side
# bound equal to the callee's would be a coin flip over which one reports
# first; a shorter one means this says "not answering yet" while the prober is
# still watching, which is the honest way round -- the service is still coming
# up and s6 will keep it, and the next `S62moonraker status` tells the truth.
# The boot never waits on any of it: this runs detached, which is what
# svc_detach is for, and the trade (log lines arriving out of order with the
# services that started after this one) is the one S50wifi and S65camera both
# already make.
ready_report() {
    if svc_s6_ready "$S6NAME" 120; then
        svc_say "answering on :7125"
        return 0
    fi
    svc_warn "NOT answering on :7125 after 120s -- `svc_s6_stat "$S6NAME"` -- last words:"
    tail -n 15 "$MOONRAKER_LOG" 2>/dev/null | sed 's/^/    /'
    return 1
}

start() {
    [ "${MOD_WEB:-1}" = "1" ] || { svc_say "disabled in anvil.conf (MOD_WEB=0)"; return 0; }

    # Every branch below says something. There is no stock server left to
    # quietly take over, so the boot log is the only place that can explain a
    # printer with no UI. A missing prerequisite is REPORTED and returns
    # non-zero; it is not a crash and it is not a stack trace out of s6, which
    # is what handing a supervisor a service it cannot run produces -- once a
    # second, for ever, in a log nobody is reading.
    if ! anvil_python_ok; then
        svc_warn "no interpreter at ${FF_PYTHON:-/usr/prog/Python-3.8.2/bin/python3} -- not started"
        return 1
    fi
    if [ ! -f "$MOONRAKER_MAIN" ]; then
        svc_warn "nothing at $MOONRAKER_MAIN -- the install did not complete"
        return 1
    fi
    mkdir -p `dirname $MOONRAKER_LOG`

    # The third prerequisite, which is new: the service directory itself. It is
    # staged into the payload by bin/patch.sh and named in the install
    # manifest, so its absence means a payload that was built without it or an
    # install that did not finish -- and it is deliberately NOT created here.
    # Writing it at runtime would mean the scandir contained a directory no
    # manifest lists, which is the exact thing the manifest exists to stop, and
    # it would put the `run` script's text inside this file where nobody would
    # ever look at it again.
    if [ ! -x "$SVCDIR/run" ]; then
        svc_warn "no $SVCDIR/run -- this payload did not ship the s6 service"
        start_unsupervised
        return $?
    fi

    if ! await_supervisor; then
        start_unsupervised
        return $?
    fi

    # And up it goes. svc_s6_up is `s6-svc -wu -u` with a bound: it asks for the
    # service to be brought up -- overriding the `down` file, which is how the
    # MOD_WEB gate above turns into a running server -- and does not return
    # until it IS up. UP, note, not READY: -wu returns as soon as s6 has forked
    # the run script, which is exactly what we want on the boot path, because
    # moonraker takes the better part of a minute to import its components on
    # this box and firmwareExe is running these scripts one at a time in the
    # foreground. 15 seconds is the shared default and is a bound on the FORK,
    # not on the startup; anything that takes longer than that to fork is a
    # scandir problem, not a moonraker problem.
    if ! svc_s6_up "$S6NAME" 15; then
        # Up it did not come. s6 has kept the reason where a reason belongs:
        # the `run` script's stderr is the scanner's stderr, which S40s6 points
        # at /usr/data/logs/s6.log. Say where, rather than paraphrasing
        # something we have not read.
        svc_warn "FAILED to come up -- `svc_s6_stat "$S6NAME"` -- see /usr/data/logs/s6.log"
        return 1
    fi
    # Forked, not serving. The difference is the whole point of the next two
    # lines, and of the notification-fd in the service directory.
    svc_detach ready_report
    svc_say "started ($MOONRAKER_MAIN); waiting for the API in the background"
    return 0
}

stop() {
    # A stop that the supervisor undoes is the classic mistake of this
    # migration, and `s6-svc -d` is what makes it not happen: it does not just
    # signal the process, it tells s6 the service is WANTED DOWN, and s6 then
    # does not start it again until something says otherwise. Killing the pid
    # instead -- which is all this script could do before, and all
    # svc_stop_daemon still does below -- would get moonraker restarted a
    # second later by a supervisor doing exactly what it was asked to do.
    #
    # -wD (inside svc_s6_down) is the other half: it returns when the service is
    # really down, not when the signal has been sent. That is the busybox
    # start-stop-daemon correction from anvil-service.sh, except in C, and it is
    # what makes `restart` safe without a sleep in front of it: the 15-second
    # bound is the same one svc_stop_daemon used, long enough for moonraker to
    # finish writing its database and short enough not to hang a boot.
    if supervised; then
        svc_s6_down "$S6NAME" 15 >/dev/null 2>&1 \
            || svc_warn "s6 did not report $S6NAME down: `svc_s6_stat "$S6NAME"`"
    fi

    # AND THE PIDFILE, which covers two live cases rather than being tidiness.
    #
    #   * The fallback above really did start a moonraker with
    #     start-stop-daemon on a printer with no scanner, and that copy has no
    #     supervisor to take it down. The pidfile is the only handle on it.
    #   * THE UPGRADE PATH. A printer running the pre-phase-5 payload has a
    #     start-stop-daemon'd moonraker alive with its pid in this file.
    #     Install this payload, then type `S62moonraker restart` instead of
    #     rebooting, and without this line that server is still there holding
    #     :7125 -- and the supervised copy this script is about to start cannot
    #     bind, exits, gets respawned, and loops for ever while s6-svstat says
    #     "up". (The run script sweeps for exactly that leftover as a second
    #     line of defence; this is the first, and it is the polite one.)
    #
    # svc_stop_daemon returns 0 immediately when the pidfile does not exist,
    # which is every printer that has rebooted once since the upgrade, so this
    # costs nothing in the normal case. It also removes the file, which is what
    # keeps `status` from answering out of a pid the kernel has since handed to
    # something else.
    svc_stop_daemon "$MOONRAKER_PID"
    svc_say "stopped"
}

status() {
    # Asked of the supervisor when there is one, because it is the only thing
    # that knows. s6-svstat's own wording is passed through -- "up (pid 1234
    # pgid 1234) 71 seconds", "down (signal SIGTERM) 4 seconds, normally up" --
    # for the reason anvil-service.sh gives for svc_s6_stat: it is the answer
    # you came for, in the shape you would have typed the command to get.
    #
    # The words "running" and "not running" are still the first thing on the
    # line, though, and that is not decoration either. It is the vocabulary
    # every other service in init.d/ answers in, it is what a human skims a
    # boot log for, and it is what case-moonraker.sh looks for. The s6 detail
    # is appended to it rather than replacing it.
    if supervised; then
        _mr_stat=`svc_s6_stat "$S6NAME"`
        case "$_mr_stat" in
            up*) svc_say "running -- $_mr_stat" ;;
            *)   svc_say "not running -- $_mr_stat" ;;
        esac
        unset _mr_stat
        return 0
    fi
    # No supervisor, so the pidfile is all there is -- and it is worth saying
    # that the answer is coming from a weaker source than usual, because "not
    # running" from a pidfile and "not running" from s6 are not the same claim.
    svc_pid_alive "$MOONRAKER_PID" \
        && svc_say "running (unsupervised, pid `cat "$MOONRAKER_PID" 2>/dev/null`)" \
        || svc_say "not running (no supervisor; asked the pidfile)"
}

svc_dispatch "$@"
