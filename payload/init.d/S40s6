#!/bin/sh
# s6-svscan -- the process supervisor, running and supervising nothing.
#
# WHY THIS EXISTS. Everything the other six scripts do by hand -- "is it still
# there", "stop it and wait until it really is gone", "start it again when it
# dies" -- is what a supervisor does in C, and anvil-service.sh has already
# had two real bugs in exactly that code (busybox start-stop-daemon -K
# returning before the process is dead; a stale socket making a dead klippy
# report itself running). s6 was measured against runit on the replica and won
# on the one thing that matters here, readiness notification: a service can
# declare itself ready and s6-svwait -U blocks until it does, which is what
# S65camera's 30-second poll of /dev/video0 and S70klipper's MCU handshake
# retry are both hand-rolling. See tools/supervisor/README.md for the
# measurements and docs/notes/80-s6-migration.md for the plan.
#
# THIS SCRIPT MIGRATES NOTHING. The scandir it scans is empty, on purpose.
# All this phase buys is that the scanner is alive on every boot before any
# service could want it, so that moving services into it later is one small
# change per service rather than one big one. A scanner with an empty scandir
# costs a single ~30KB process and does nothing at all -- measured on the
# replica: it starts clean, prints not one line, and answers its control
# socket. "Supervising nothing" is a supported state, not a degenerate one.
#
# THE NUMBERING IS LOAD-BEARING, the same way it is for S60nginx. firmwareExe
# runs $MODDIR/init.d/S* in filename order, so 40 puts the scanner before
# S50wifi and therefore before every service that will later be supervised by
# it -- a service coming up and asking for a scanner that does not exist yet
# is the one ordering mistake this file exists to prevent. It is not S00 or
# S10 because those numbers are worth keeping free for something that has to
# run BEFORE the supervisor (a filesystem check, a migration); nothing below
# 40 exists today and this script has no reason to claim the whole range.
#
# IT MUST NOT BLOCK THE BOOT, and this is the sharp edge. s6-svscan NEVER
# RETURNS -- that is its entire job. firmwareExe runs these scripts one at a
# time in the FOREGROUND, so running the scanner inline does not delay the
# boot, it ENDS it: no wifi, no ssh, no Mainsail, no Klipper and no screen,
# for ever, on every boot, with no way in to find out why. So it is
# backgrounded through svc_detach -- exactly how S65camera backgrounds the
# respawn loop it hand-rolls for mjpg_streamer -- and start() returns at once.
#
# WHAT RESTARTS THE SCANNER IF IT DIES? Nothing, and that is a decision, not
# an oversight. We are not PID 1 and there is no supervisor above this one; a
# watchdog for it would be one more hand-rolled respawn loop in ash, which is
# the exact thing we are buying s6 to delete. What exists instead is
# proportionate to how it can actually fail:
#
#   * It is one small C program that allocates nothing after startup and
#     blocks in poll(). The realistic way it "dies" is not a crash but a bad
#     BUILD -- the -D_FILE_OFFSET_BITS=64 trap in tools/supervisor/README.md,
#     where it execs fine and then dies on readdir() with EOVERFLOW. A
#     watchdog would respawn that forever and change nothing. start() below
#     therefore waits for the scanner to answer and SAYS SO when it does not,
#     which is the only response that helps.
#   * If it does die, the s6-supervise processes it started keep running and
#     keep respawning their own services. A dead scanner is a printer that has
#     stopped noticing changes to the scandir, not a printer that has stopped
#     printing. Today, with an empty scandir, it is not even that.
#   * firmwareExe re-checks it once after the init loop and restarts it there
#     if it is gone -- the same last-resort shape it already uses for Klipper,
#     and for the same reason: the check is cheap, it runs at the one moment
#     something else has already gone wrong, and the log line it prints is the
#     thing you would otherwise have had to guess.
#
# So: no watchdog, one re-check on the boot path, and a loud start(). If that
# ever proves too little, the honest fix is an inittab-style respawn, not a
# `while true` in a shell script.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
# The library path and the interpreter, from the one file that defines them.
# s6 itself needs nothing from it -- it is static-pie musl and links against
# no shared object on this box, which is exactly why it was built that way --
# but a script that gets re-run over ssh should get the same environment on
# every path, and sourcing it twice is a no-op.
if [ -f $MODDIR/anvil-env.sh ]; then
    . $MODDIR/anvil-env.sh
else
    echo "s6: !! no $MODDIR/anvil-env.sh -- the mod payload is not installed"
fi
# start/stop/status/liveness, shared with the other services. See
# anvil-service.sh for the whole API -- including the svc_s6_* helpers, which
# are only usable because this script is what puts a scanner behind them.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "s6: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=s6

# SVC_S6_BIN and SVC_S6_SCANDIR come from anvil-service.sh: every script that
# talks to the scanner has to agree with this one about where it is, and the
# way to make that true is to name it once, in the file they all source.
SVSCAN=$SVC_S6_BIN/s6-svscan
SCANDIR=$SVC_S6_SCANDIR
# The pidfile holds the SCANNER, not a supervisor: stop() has to be able to
# take down the one process that would otherwise put everything back. Same
# reasoning as the pidfile in S65camera, which holds the respawn loop rather
# than the streamer it respawns.
PIDFILE=$MODDIR/s6-svscan.pid
# The scanner's own output, in a file of its own. A healthy s6-svscan says
# NOTHING -- verified on the replica, where three seconds on an empty scandir
# produced an empty log -- so anything landing here is a fault worth finding
# on its own. It is not left on the inherited descriptor because the scanner
# OUTLIVES firmwareExe's redirection: it would otherwise keep writing into the
# boot log of a boot that finished hours ago.
LOG=/usr/data/logs/s6.log

scanner() {
    mkdir -p /usr/data/logs
    # exec, so the pid svc_detach captured IS the scanner's pid rather than
    # that of a shell which happens to have started one. svc_stop_daemon
    # signals whatever is in the pidfile, and signalling a wrapper that has
    # already gone would leave the scanner running with nothing pointing at it.
    exec "$SVSCAN" "$SCANDIR" >>"$LOG" 2>&1
}

start() {
    [ "${MOD_S6:-1}" = "1" ] || { svc_say "disabled in anvil.conf (MOD_S6=0)"; return 0; }
    if [ ! -x "$SVSCAN" ]; then
        svc_warn "no $SVSCAN -- this payload did not ship the supervisor"
        return 1
    fi
    if svc_s6_running; then
        svc_say "already scanning $SCANDIR"
        return 0
    fi

    # WHY THE mkdir IS HERE AS WELL AS IN THE PAYLOAD. bin/patch.sh stages
    # etc/s6/ into the payload, so the directory ships, lands on a real
    # install, and -- the reason for staging it rather than only creating it
    # here -- is NAMED IN THE INSTALL MANIFEST, which is what lets a later
    # update account for it instead of orphaning it. But it ships EMPTY, and
    # an empty directory is precisely the kind of payload path that other
    # things legitimately remove: run-append.sh's manifest pass rmdir's every
    # empty directory the PREVIOUS payload listed, and it does that before the
    # new tarball is extracted. So there is a window; and there are printers
    # somebody installed by hand. One mkdir -p costs nothing and deletes a
    # whole class of "the scanner did not start and the log says ENOENT".
    mkdir -p "$SCANDIR" || { svc_warn "cannot create $SCANDIR"; return 1; }

    # svc_detach leaves the scanner's pid in SVC_BG_PID; it is written to the
    # pidfile because the scanner is the half of this that has to be killable.
    svc_detach scanner
    echo "$SVC_BG_PID" > "$PIDFILE"

    # Then wait for it to answer -- but only for a thing that takes no time.
    # s6-svscan is up once it has created $SCANDIR/.s6-svscan/, taken the lock
    # and started reading the control FIFO: a mkdir, a mkfifo and two opens.
    # It waits on no hardware, no network and no other service, so the check
    # below almost always succeeds on its first pass and costs nothing. What
    # it buys is that the "scanning" line is TRUE when it is printed, and that
    # a scanner which exec'd and then died -- the EOVERFLOW build trap above
    # -- is reported here, by name, instead of silently three phases from now
    # when a service is moved into the scandir and never comes up. The 5s
    # bound is only ever paid on a printer that is already broken.
    _s6_waited=0
    while ! svc_s6_running && [ $_s6_waited -lt 5 ]; do
        sleep 1
        _s6_waited=$((_s6_waited + 1))
    done
    if svc_s6_running; then
        svc_say "scanning $SCANDIR (pid $SVC_BG_PID)"
        unset _s6_waited
        return 0
    fi
    svc_warn "started but is not answering on $SCANDIR after ${_s6_waited}s -- see $LOG"
    unset _s6_waited
    return 1
}

stop() {
    # -t is the documented way down, and the only one that keeps the promise
    # "stop leaves no s6 processes behind": it tells the scanner to send TERM
    # to every s6-supervise it started, reap them, and then exit itself.
    # Killing the scanner on its own would leave those supervisors orphaned
    # and still respawning their services -- the same mistake as killing
    # mjpg_streamer without its respawn loop, which S65camera's stop() is
    # written the way it is to avoid. It costs nothing today, with nothing to
    # supervise, and it is the line that has to already be right on the day
    # phase 4 puts the first service in there.
    if [ -x "$SVC_S6_BIN/s6-svscanctl" ] && svc_s6_running; then
        "$SVC_S6_BIN/s6-svscanctl" -t "$SCANDIR" 2>/dev/null
        _s6_waited=0
        while svc_s6_running && [ $_s6_waited -lt 15 ]; do
            sleep 1
            _s6_waited=$((_s6_waited + 1))
        done
        svc_s6_running && svc_warn "still answering after ${_s6_waited}s"
        unset _s6_waited
    fi
    # Then the pidfile, which does two things -t does not. It REMOVES the file
    # -- svc_pid_alive on a recycled pid is how `status` once came to report an
    # unrelated process as a running service -- and it is the way out when the
    # scanner is wedged badly enough not to read its own control socket: a
    # plain TERM to the pid exits it too, verified on the replica.
    svc_stop_daemon "$PIDFILE"
    svc_say "stopped"
}

status() {
    # Asked of the SCANNER, not of the process table. `s6-svscanctl -a` is a
    # request to rescan the scandir -- harmless, idempotent, and it travels
    # down the control FIFO, so it can only succeed if something on the other
    # end is reading. A dead scanner leaves that FIFO on disk and the ping
    # then fails with "supervisor not listening" (exit 100), which is exactly
    # the distinction a `ps | grep` cannot make and the distinction that made
    # a stale pidfile lie about moonraker.
    if svc_s6_running; then
        svc_say "scanning $SCANDIR"
    else
        svc_say "not running"
    fi
    # And what it is supervising, if anything. Zero is correct today and stays
    # correct until phase 4 puts the first service directory in there; saying
    # the number rather than nothing is what makes that change visible the day
    # it happens. The glob skips .s6-svscan/ -- the scanner's own control
    # directory is hidden, which is why it is not a service here.
    _s6_n=0
    for _s6_d in "$SCANDIR"/*; do
        [ -d "$_s6_d" ] || continue
        _s6_n=$((_s6_n + 1))
        _s6_name=`basename "$_s6_d"`
        svc_say "  $_s6_name: `svc_s6_stat "$_s6_name" 2>&1`"
    done
    svc_say "$_s6_n service directories in $SCANDIR"
    unset _s6_n _s6_d _s6_name
}

svc_dispatch "$@"
