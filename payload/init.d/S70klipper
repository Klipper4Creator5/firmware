#!/bin/sh
# Klipper.
#
# WHY THIS EXISTS -- the single most important dependency in this whole mod:
# on stock firmware nothing in /etc/init.d starts Klipper. It is FlashForge's
# firmwareExe that runs "/usr/prog/klipper/start.sh &" (verified with
# `strings firmwareExe`). So the moment HelixScreen replaces firmwareExe, the
# printer boots to a working screen with NO klippy behind it: no motion, no
# heaters, no printing.
#
# Therefore Klipper startup is owned here, independently of the UI.
#
# Double-start guard: we only start Klipper if it is not already running, and
# start.sh carries the same guard, so a restart over ssh cannot end up with two
# klippys against the same MCU.
#
# WHY IT ALSO SUPERVISES -- the heater board (mcu 'eheaterboard' on
# /dev/ttyS4) is frequently not answering yet when klippy first opens the
# port. Klipper polls it for 90s (connect_uart) and then gives up with "MCU
# error during connect". klippy does NOT exit and does NOT retry on its own:
# _connect() sets the error state, returns, and fires FlashForge's own
# klippy:notify_mcu_error event over /tmp/uds. On stock, firmwareExe is the
# API client listening for that event, and it restarts the firmware -- which
# is why FlashForge's UI needs two or three attempts before every board is
# found. Nothing in the mod plays that role, so klippy would sit in the error
# state forever with no heaters. Restarting klippy achieves what the stock
# retry achieves: reopening the port toggles DTR/RTS and the board comes up.
#
# The retry is the safety net, not the fix: the actual fix is the bootloader
# handshake (ff_mcu_bringup.py). A board that missed its window still gets
# another chance on each restart here, because start.sh redoes the bring-up
# every time it runs.
#
# WHO NORMALLY DOES ALL THIS NOW. bin/ff-startup.py, which runs from the
# firmwareExe wrapper right after these init scripts. It owns the sequence
# because the bring-up has to happen before klippy opens the ports and the
# retry that fixes a stranded board is "hand it over again, then reopen" --
# so the thing doing the handshake has to be the thing restarting klippy. It
# also has moonraker to ask, instead of tailing printer.log for markers, and
# a screen to say which board is missing.
#
# This script therefore STANDS ASIDE when that program is going to run, and
# does the whole job itself when it cannot -- no interpreter, no script,
# MOD_STARTUP=0. Klipper starting is the single most important thing the mod
# does and it must not come to depend on python. `force-start` ignores the
# hand-off; the wrapper uses it as a last resort if ff-startup returned and
# left no klippy behind.
#
# It is not a GPIO poke: firmwareExe drives only PB07 (wifi module power) and
# gpios 34/35, and that pair is the NRST/BOOT0 of the /dev/ttyS3 board, driven
# only by AppUpdateThread when flashing MCU firmware from the DeviceOTA
# screen. Neither runs on a normal boot.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
# start/stop/status/liveness, shared with the other services. See
# anvil-service.sh for the whole API.
if [ -f $MODDIR/anvil-service.sh ]; then
    . $MODDIR/anvil-service.sh
else
    echo "klipper: !! no $MODDIR/anvil-service.sh -- the mod payload is not installed"
    exit 1
fi
SVC_NAME=klipper
# `force-start` is this script's own verb; naming it here keeps the usage line
# svc_dispatch prints true. See the case block at the bottom.
SVC_EXTRA_VERBS="|force-start"

KLIPPER_TRIES=${MOD_KLIPPER_TRIES:-6}
PRINTER_LOG=/usr/data/logs/printer.log

# klippy is started by FlashForge's start.sh, not by us, so there is no pidfile
# and the only handle on it is the name: svc_proc_alive 'klippy\.py', which is
# the pgrep-with-a-ps-fallback this script used to carry itself.
#
# klippy_running is deliberately MORE than that. /tmp/uds is the socket klippy
# serves its API on, and it is what start.sh itself looks at before deciding
# whether to start anything -- so a printer with the socket present is one
# start.sh will refuse to touch, whatever `ps` says. Both questions matter and
# they are not the same question, which is why this one stays here rather than
# moving into anvil-service.sh: no other service has a socket to ask about.
klippy_running() {
    [ -S /tmp/uds ] && return 0
    svc_proc_alive 'klippy\.py' && return 0
    return 1
}

# The two outcomes klippy actually writes to printer.log. There is no
# "Printer is ready" line to look for -- _set_state() does not log -- but a
# healthy klippy emits a "Stats <n>:" line every second.
klippy_verdict() {
    tail -n +$(($1 + 1)) "$PRINTER_LOG" 2>/dev/null | awk '
        /MCU error during connect/ { print "error"; exit }
        /Stats [0-9]/              { print "ready"; exit }'
}

supervise() {
    attempt=1
    while [ $attempt -le $KLIPPER_TRIES ]; do
        # NOT `wc -l < "$PRINTER_LOG" 2>/dev/null`: redirections are applied
        # left to right, so the input redirect fails and the shell prints
        # "can't open ...: no such file" BEFORE 2>/dev/null is in effect. On
        # a first boot printer.log does not exist yet, so that message landed
        # in the boot log every time, interleaved with whatever else was
        # writing -- which is what made one user's log unreadable at exactly
        # the point they were trying to diagnose.
        log_lines=`cat "$PRINTER_LOG" 2>/dev/null | wc -l`
        [ -n "$log_lines" ] || log_lines=0
        # A failed connect takes ~90s to be reported, so wait out more than
        # that before concluding anything.
        waited=0
        verdict=""
        while [ $waited -lt 30 ]; do
            sleep 5
            waited=$((waited + 1))
            verdict=`klippy_verdict "$log_lines"`
            [ -n "$verdict" ] && break
        done
        case "$verdict" in
            ready)
                svc_say "ready (attempt $attempt)"
                return 0
                ;;
            "")
                # Neither marker showed up. Something other than an MCU
                # connect is going on; restarting would only hide it.
                svc_say "no verdict after attempt $attempt -- leaving it alone"
                return 0
                ;;
        esac
        svc_warn "MCU connect failed (attempt $attempt/$KLIPPER_TRIES) -- restarting"
        klippy_down
        /usr/prog/klipper/start.sh
        attempt=$((attempt + 1))
    done
    svc_warn "still no MCU after $KLIPPER_TRIES attempts -- giving up"
    return 1
}

# Take klippy down and leave nothing behind that would stop the next start.
#
# The wait is not optional. klipperDaemon stop signals and returns; klippy is
# still holding /dev/ttyS4 for a moment after that, and start.sh reopening the
# port while the old process still has it is exactly the MCU failure this
# script exists to retry out of. Bounded at 15s for the reason svc_stop_daemon
# is: a stuck klippy should be said out loud, not waited on forever.
#
# And then the socket. start.sh bails out if /tmp/uds is still there, and
# klippy does not unlink it on exit -- so a stale socket is a pidfile that
# lies, in precisely the sense svc_stop_daemon removes pidfiles. It is only
# removed once klippy is definitely gone: removing it out from under a live
# klippy would leave a running printer nothing could talk to.
klippy_down() {
    [ -x /usr/prog/klipper/klipperDaemon ] && /usr/prog/klipper/klipperDaemon stop
    stopping=0
    while svc_proc_alive 'klippy\.py' && [ $stopping -lt 15 ]; do
        sleep 1
        stopping=$((stopping + 1))
    done
    if svc_proc_alive 'klippy\.py'; then
        svc_warn "klippy still running after ${stopping}s"
        return 1
    fi
    rm -f /tmp/uds
    return 0
}

# Is bin/ff-startup.py actually going to run and do this? Every condition the
# wrapper checks, checked the same way -- if any of them is false this script
# keeps the job.
startup_owns_klipper() {
    [ "${MOD_STARTUP:-1}" = 1 ] || return 1
    [ -f $MODDIR/bin/ff-startup.py ] || return 1
    [ -x /usr/prog/Python-3.8.2/bin/python3 ] || command -v python3 >/dev/null 2>&1 || return 1
    return 0
}

start() {
    if klippy_running; then
        svc_say "already running"
        return 0
    fi
    if [ "$1" != force ] && startup_owns_klipper; then
        svc_say "left to ff-startup.py (it does the MCU bring-up first)"
        return 0
    fi
    [ -x /usr/prog/klipper/start.sh ] || { svc_warn "start.sh missing"; return 1; }
    # start.sh does the MCU bring-up itself, and that costs a few seconds per
    # unresponsive board -- so it goes to the background; boot must not stall.
    svc_detach /usr/prog/klipper/start.sh
    svc_say "start.sh launched"
    # In the background: boot must not wait minutes for the heater board.
    svc_detach supervise
}

stop() {
    klippy_down
    svc_say "stopped"
}

status() {
    klippy_running && svc_say "running" || svc_say "not running"
}

# force-start and restart are handled here, before svc_dispatch, because both
# need the argument svc_dispatch does not pass: `start force`. This script's
# start() normally STANDS ASIDE for ff-startup.py, so a plain `stop; start` --
# which is what svc_dispatch's restart is -- would stop klippy and then decline
# to start it, leaving the printer with no motion and no heaters. A restart
# asked for by hand means restart it, so it forces. There is no `sleep 2` in
# front of the start any more: stop() now waits for klippy to actually be gone
# and clears the stale socket, which is what the sleep was approximating.
case "$1" in
    force-start) start force ;;
    restart)     stop; start force ;;
    *)           svc_dispatch "$@" ;;
esac
