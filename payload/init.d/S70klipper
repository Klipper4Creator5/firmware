#!/bin/sh
# Klipper.
#
# WHY THIS EXISTS -- the single most important dependency in this whole mod:
# on stock firmware nothing in /etc/init.d starts Klipper. It is FlashForge's
# firmwareExe that runs "/usr/prog/klipper/start.sh &" (verified with
# `strings firmwareExe`). So the moment HelixScreen replaces firmwareExe, the
# printer boots to a working screen with NO klippy behind it: no motion, no
# heaters, no printing.
#
# Therefore Klipper startup is owned here, independently of whichever UI runs.
#
# Double-start guard: when MOD_UI=stock, firmwareExe still starts Klipper
# itself, so we must not race it. We only start Klipper if it is not already
# running, and start.sh carries the same guard.
#
# WHY IT ALSO SUPERVISES -- the heater board (mcu 'eheaterboard' on
# /dev/ttyS4) is frequently not answering yet when klippy first opens the
# port. Klipper polls it for 90s (connect_uart) and then gives up with "MCU
# error during connect". klippy does NOT exit and does NOT retry on its own:
# _connect() sets the error state, returns, and fires FlashForge's own
# klippy:notify_mcu_error event over /tmp/uds. On stock, firmwareExe is the
# API client listening for that event, and it restarts the firmware -- which
# is why the stock UI needs two or three attempts before every board is
# found. Nothing in the mod plays that role, so klippy would sit in the error
# state forever with no heaters. Restarting klippy achieves what the stock
# retry achieves: reopening the port toggles DTR/RTS and the board comes up.
#
# The retry is the safety net. mcu_bringup() below is the actual fix.
#
# It is not a GPIO poke: firmwareExe drives only PB07 (wifi module power) and
# gpios 34/35, and that pair is the NRST/BOOT0 of the /dev/ttyS3 board, driven
# only by AppUpdateThread when flashing MCU firmware from the DeviceOTA
# screen. Neither runs on a normal boot.
MODDIR=/usr/data/anvil
[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf

KLIPPER_TRIES=${MOD_KLIPPER_TRIES:-6}
PRINTER_LOG=/usr/data/logs/printer.log

klippy_proc() {
    if command -v pgrep >/dev/null 2>&1; then
        pgrep -f 'klippy\.py' >/dev/null 2>&1
    else
        ps 2>/dev/null | grep 'klippy.py' | grep -v grep >/dev/null
    fi
}

klippy_running() {
    [ -S /tmp/uds ] && return 0
    klippy_proc && return 0
    return 1
}

# The two outcomes klippy actually writes to printer.log. There is no
# "Printer is ready" line to look for -- _set_state() does not log -- but a
# healthy klippy emits a "Stats <n>:" line every second.
klippy_verdict() {
    tail -n +$(($1 + 1)) "$PRINTER_LOG" 2>/dev/null | awk '
        /MCU error during connect/ { print "error"; exit }
        /Stats [0-9]/              { print "ready"; exit }'
}

# --------------------------------------------------------- MCU bring-up
# Three boards answer Klipper only after a bootloader handshake: the board
# sends "Ready", the host replies 'A', the board acks 0x06 and jumps to its
# application. On stock, firmwareExe carries that routine three times over --
# bootSerialHeatMcu, bootSerialMainEboardMcu and bootSerialLevelBoardMcu,
# byte-identical apart from a hard-coded device path, which is why it never
# needed to parameterise anything. start.sh covers only two of the four:
#
#   /dev/ttyS2  mcu           cmd_mcu bootup, in start.sh      ok
#   /dev/ttyS5  eboard        checkEboard, in start.sh         ok
#   /dev/ttyS4  eheaterboard  NOBODY   <-- why klippy could not connect
#   /dev/ttyS7  levelboard    NOBODY
#
# checkEboard is a standalone build of the ttyS5 variant and takes no
# arguments, so it cannot be aimed at another port. The handshake is small
# and fully known, so do it here rather than depend on someone else's
# .rodata: raw 115200 with VMIN=0/VTIME=1 (so every read returns after 0.1s
# whether or not the board spoke), at most 50 reads, and the ACK goes out
# only after the board actually said "Ready".
#
# Harmless against a board that is already running: it never sends the
# banner, so we read 50 times, send nothing at all, and give up after ~5s.
mcu_poke() {
    dev=/dev/ttyS$1
    [ -c "$dev" ] || { echo "klipper: $dev missing -- skipping"; return 1; }
    stty -F "$dev" 115200 raw -echo -crtscts min 0 time 1 2>/dev/null || {
        echo "klipper: cannot configure $dev -- skipping"
        return 1
    }
    # Hold the port open for the whole exchange, as firmwareExe does. -hupcl
    # is set above, so closing it later will not drop DTR on the board.
    exec 3<>"$dev" || { echo "klipper: cannot open $dev -- skipping"; return 1; }
    i=0
    while [ $i -lt 50 ]; do
        i=$((i + 1))
        case `dd bs=64 count=1 <&3 2>/dev/null` in
        *Ready*)
            printf 'A' >&3
            ack=`dd bs=1 count=1 <&3 2>/dev/null | od -An -tu1 | tr -d ' \n'`
            exec 3>&-
            if [ "$ack" = "6" ]; then
                echo "klipper: $dev started its application (ack $ack, $i reads)"
                return 0
            fi
            echo "klipper: $dev said Ready but acked '$ack' -- carrying on"
            return 1
            ;;
        esac
    done
    exec 3>&-
    echo "klipper: $dev sent no bootloader banner -- already running"
    return 0
}

# ttyS2 and ttyS5 are already handled inside start.sh.
mcu_bringup() {
    for p in 4 7; do
        mcu_poke $p
    done
}

supervise() {
    n=1
    while [ $n -le $KLIPPER_TRIES ]; do
        mark=`wc -l < "$PRINTER_LOG" 2>/dev/null || echo 0`
        # A failed connect takes ~90s to be reported, so wait out more than
        # that before concluding anything.
        w=0
        verdict=""
        while [ $w -lt 30 ]; do
            sleep 5
            w=$((w + 1))
            verdict=`klippy_verdict "$mark"`
            [ -n "$verdict" ] && break
        done
        case "$verdict" in
            ready)
                echo "klipper: ready (attempt $n)"
                return 0
                ;;
            "")
                # Neither marker showed up. Something other than an MCU
                # connect is going on; restarting would only hide it.
                echo "klipper: no verdict after attempt $n -- leaving it alone"
                return 0
                ;;
        esac
        echo "klipper: MCU connect failed (attempt $n/$KLIPPER_TRIES) -- restarting"
        [ -x /usr/prog/klipper/klipperDaemon ] && /usr/prog/klipper/klipperDaemon stop
        g=0
        while klippy_proc && [ $g -lt 15 ]; do sleep 1; g=$((g + 1)); done
        # start.sh bails out if the socket is still there, so clear a stale
        # one -- but only once klippy is definitely gone.
        klippy_proc || rm -f /tmp/uds
        mcu_bringup
        /usr/prog/klipper/start.sh
        n=$((n + 1))
    done
    echo "klipper: still no MCU after $KLIPPER_TRIES attempts -- giving up"
    return 1
}

start() {
    if klippy_running; then
        echo "klipper: already running"
        return 0
    fi
    if [ "${MOD_UI:-stock}" = "stock" ]; then
        # firmwareExe will start it, and it does its own retrying. Give it a
        # moment, then only step in if it did not, so a stock-UI machine
        # behaves exactly like stock.
        sleep 15
        if klippy_running; then
            echo "klipper: started by firmwareExe (stock path)"
            return 0
        fi
        echo "klipper: firmwareExe did not start it -- starting directly"
    fi
    [ -x /usr/prog/klipper/start.sh ] || { echo "klipper: start.sh missing"; return 1; }
    # The handshake must finish before klippy opens the ports, and it costs
    # ~2s per board, so the whole sequence goes to the background together --
    # boot must not stall behind it.
    { mcu_bringup; /usr/prog/klipper/start.sh; } &
    echo "klipper: MCU bring-up + start.sh launched"
    # In the background: boot must not wait minutes for the heater board.
    supervise &
}
stop() {
    [ -x /usr/prog/klipper/klipperDaemon ] && /usr/prog/klipper/klipperDaemon stop
    echo "klipper: stopped"
}
case "$1" in
    start|'') start ;;
    stop)     stop ;;
    restart)  stop; sleep 2; start ;;
    status)   klippy_running && echo "klipper: running" || echo "klipper: not running" ;;
    *) echo "usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
