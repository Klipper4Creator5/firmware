#!/bin/sh
# /usr/prog/PROGRAM/software/firmwareExe  -- REPLACED by the mod.
#
# The stock boot chain is:
#     busybox init -> /etc/init.d/rcS -> S99factory_test_shell
#         -> /usr/prog/app_startup.sh -> firmwareExe
# and firmwareExe itself is what launches "/usr/prog/klipper/start.sh &".
#
# Because everything funnels through this one path, replacing this binary
# with a script is the cleanest possible integration point: app_startup.sh,
# rcS and the whole init chain stay 100% STOCK and are never patched.
#
# HelixScreen is the only UI. FlashForge's binary is not kept anywhere: the
# installer wipes the software dir before run.sh anyway, so the way back is
# flashing the stock FlashForge package, which still ships it.
#
# Two further properties we get for free:
#   * app_startup.sh's own watchdog greps `ps` for "firmwareExe" 5s after
#     launch. This script keeps that name (it IS $0) and stays in the
#     FOREGROUND, so the stock watchdog supervises the mod correctly.
#   * If this script is ever removed, app_startup.sh restores a firmwareExe
#     from a version directory (the last `ls` entry, alphabetical -- and there is
# normally only one) -- the stock recovery path still works.

MODDIR=/usr/data/anvil

[ -f $MODDIR/anvil.conf ] && . $MODDIR/anvil.conf
mkdir -p /usr/data/logs
exec >>/usr/data/logs/anvil-boot.log 2>&1
echo "=== mod firmwareExe `date 2>/dev/null` ==="

# ---- something on the panel, immediately ---------------------------------
# From here until HelixScreen paints, nothing owns the screen. That gap is
# the whole boot on EVERY start, not just the first: the migration below
# exits at its stamp and draws nothing. FlashForge's own splash cannot fill
# it -- /usr/prog/start.img exists, but the only two lines that would display
# it (both in app_startup.sh) are commented out, so nothing has shown it for
# a long time.
FF_PY=/usr/prog/Python-3.8.2/bin/python3
[ -x "$FF_PY" ] || FF_PY=python3
LD_LIBRARY_PATH=/usr/prog/Python-3.8.2/lib:$LD_LIBRARY_PATH
LD_LIBRARY_PATH=/usr/prog/openssl-1.0.2d/lib:$LD_LIBRARY_PATH
LD_LIBRARY_PATH=/usr/prog/libffi-3.4.4/lib:$LD_LIBRARY_PATH
export LD_LIBRARY_PATH
splash() {
    [ "${MOD_SPLASH:-1}" = 1 ] || return 0
    [ -f $MODDIR/bin/ffscreen.py ] || return 0
    "$FF_PY" $MODDIR/bin/ffscreen.py "$@" 2>/dev/null || true
}
splash --title "REFORGE" --status "STARTING THE PRINTER" --progress 0.02

# ---- services ------------------------------------------------------------
# init.d-style scripts, run in filename order. One failing service must never
# stop the rest: Klipper has to come up even if the web stack is broken.
if [ -d $MODDIR/init.d ]; then
    for s in $MODDIR/init.d/S*; do
        [ -x "$s" ] || continue
        echo "--- `basename $s` ---"
        "$s" start || echo "`basename $s`: returned $?"
    done
fi

# ---- one-time migration of the factory calibration -----------------------
# Creator-5-specific, and specific to the FIRST boot after the install: this
# unit's nozzle/dock/station numbers live in firmwareExe's own JSON and have
# to be moved into printer.cfg once. It runs HERE, ahead of the UI, on
# purpose -- the save it makes restarts klippy, and doing that behind a
# HelixScreen that is already showing a printer is worse than making the
# splash wait. Every boot after the first costs one stat() of the stamp.
#
# It is a separate program (bin/ff-firstboot-import.py) rather than something
# klippy does to itself, because it must see klipper AND moonraker up before
# it decides anything -- it drives both commands over the moonraker API.
#
# The browser UI is not part of that: it is a build-time choice and MOD_WEB=0
# removes it, so with the web stack off we tell the importer not to wait for
# one at all. With it on, the importer waits briefly and proceeds regardless.
if [ "${MOD_IMPORT:-1}" = 1 ] && [ -f $MODDIR/bin/ff-firstboot-import.py ]; then
    "$FF_PY" $MODDIR/bin/ff-firstboot-import.py \
        --timeout "${MOD_IMPORT_TIMEOUT:-240}" \
        || echo "ff-import: returned $? -- the next boot will try again"
fi

# ---- the UI, in the foreground so the stock watchdog can see us ----------
# S80ui already decided and wrote its verdict here: "helix" to start the UI,
# "none" to stay headless (MOD_UI=0, or HelixScreen not installed).
UI_CHOICE=`cat $MODDIR/.ui-choice 2>/dev/null || echo none`
echo "ui: choice is $UI_CHOICE"

if [ "$UI_CHOICE" = helix ]; then
    splash --title "REFORGE" --status "STARTING THE SCREEN" --progress 0.9
    HELIX_DATA_DIR=$MODDIR/helixscreen
    HELIX_LOG_DEST=file
    HELIX_LOG_FILE=/usr/data/logs/helixscreen.log
    export HELIX_DATA_DIR HELIX_LOG_DEST HELIX_LOG_FILE
    if [ -x $MODDIR/helixscreen/bin/helix-launcher.sh ]; then
        $MODDIR/helixscreen/bin/helix-launcher.sh
    else
        $MODDIR/helixscreen/bin/helix-screen
    fi
fi

# If the UI exits -- or was never started at all -- we do NOT exit: dropping
# out of this script makes app_startup.sh think the UI died and re-exec us,
# which would restart every service. Hold the process instead; ssh and
# Mainsail remain available.
splash --title "REFORGE" \
       --status "NO SCREEN" \
       --detail "MAINSAIL AND SSH ARE RUNNING. SET MOD_UI=1 IN ANVIL.CONF TO TURN THE SCREEN ON."
echo "ui: nothing left in the foreground -- holding process so services stay up"
while true; do sleep 3600; done
