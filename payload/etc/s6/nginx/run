#!/bin/sh
# The nginx service, as s6 runs it. Exec'd by s6-supervise, never by hand.
#
# WHAT A `run` SCRIPT IS. s6-svscan sees this directory in the scandir and
# starts one s6-supervise for it; that s6-supervise forks, puts the child in a
# process group of its own, and execs this file. The process this script turns
# into IS the service: when it exits, s6-supervise runs `finish` if there is
# one and then starts the whole thing again. That is the entire contract, and
# every line below follows from it.
#
# THEREFORE: `daemon off;`. nginx's default is to fork a master into the
# background and return, which is what init.d/S60nginx relied on for years and
# is exactly wrong here -- s6 would supervise the process that forked and
# exited, decide the service had died a millisecond after starting it, and
# start it again, for ever, while the real nginx it left behind kept serving
# quite happily and was supervised by nobody. `-g` puts a directive on the
# command line as though it were at the top of nginx.conf, so the config file
# stays the one thing it should be -- shared with the hand-run and fallback
# paths -- and only the way we are launching it changes. Verified on the
# replica against this printer's own nginx (1.5.0, FlashForge's build, from
# /usr/prog): with `daemon off;` the pid we launched is still the master five
# seconds later, and it still writes logs/nginx.pid, which is what lets
# S60nginx's non-supervised fallback keep working unchanged.
#
# AND `exec`. Without it this shell would stay around as the parent of nginx,
# s6 would supervise the shell, and every signal s6 sent -- the SIGTERM behind
# `S60nginx stop` above all -- would go to a shell that ignores it while nginx
# carried on. exec makes the pid s6 is holding the pid of nginx itself.
#
# THIS FILE DOES NOT LOOK AT MOD_WEB. It cannot: it runs whenever s6 decides
# the service should be up, and a `run` that exits because it disagrees is a
# respawn loop with extra steps. The gate is the `down` file next to this one
# plus init.d/S60nginx, which is the thing that reads anvil.conf. See the
# comment in `down` -- that is where the whole MOD_WEB story is written.
MODDIR=/usr/data/anvil
NGINX=/usr/prog/nginx/sbin/nginx

# -p sets the prefix: logs, the pidfile and the temp directories all land
# under $MODDIR on the data partition, never on /usr/prog. nginx will not
# start if it cannot create them and it does not create them itself -- the
# same mkdir S60nginx has always done, repeated here because s6 restarts this
# service without going anywhere near S60nginx, and a service that only works
# when a shell script happened to run first is not supervised, it is lucky.
mkdir -p $MODDIR/nginx/logs $MODDIR/nginx/tmp

# THE ORPHANED WORKER, and why there is a loop in what should be two lines.
#
# nginx is two processes: a master that binds :80 and a worker that inherits
# the listening socket and answers on it. Kill the master politely -- which is
# what `s6-svc -d` does, SIGTERM -- and it shuts the worker down with it;
# measured on the replica, nothing is left and the port is free. Kill the
# master with SIGKILL, which is what an OOM or a `kill -9` does, and the
# worker is orphaned, KEEPS THE LISTENING SOCKET, and goes on serving. s6 then
# does its job perfectly and makes everything worse: it starts a new nginx one
# second later, that nginx cannot bind because the orphan still holds :80, it
# retries five times over five seconds, prints "still could not bind()" and
# exits, and s6 starts it again. For ever. `s6-svstat` says "up" the whole
# time -- the process it is watching really is alive, it is just failing --
# while what is actually answering the browser is an unsupervised leftover.
# All of that was measured on the replica; none of it is a guess.
#
# So: before nginx starts, anything already speaking for it is a leftover, and
# leftovers get killed. That is true by construction -- s6-supervise runs
# exactly one copy of this service at a time, so at the moment this line runs
# there is no nginx of ours anywhere -- and it makes the fallback in S60nginx
# safe as well: a printer that started nginx directly because the scanner was
# not running gets that copy swept the moment the supervised one takes over,
# instead of two nginxes fighting over the port.
#
# It reads /proc rather than `ps | grep`, which is the opposite of what the
# rest of the mod does and is deliberate. busybox `ps` truncates its output to
# the terminal width, so on the replica the command line arrives cut off at
# "/usr/prog/nginx/" and a grep for the binary matches nothing at all; and
# busybox `kill` will not take a negative pid, so signalling the process group
# -- the obvious fix -- is not available on this box either. Both were tried
# and both failed there. /proc/PID/cmdline is the whole command line, always.
#
# The match is POSITIVE and narrow, because the cost of a wrong match here is
# not a missed cleanup, it is killing the wrong thing: "s6-supervise nginx",
# "/usr/data/anvil/init.d/S60nginx start" and this very script all have the
# word nginx in their command lines, and s6-supervise in particular is the
# process that would otherwise restart us. So only two shapes are swept -- the
# ones nginx itself produces:
#
#   nginx: master process /usr/prog/nginx/sbin/nginx -p ...   (it rewrites
#   nginx: worker process                                      its own argv)
#   ...anything exec'd from /usr/prog/nginx/sbin/nginx         (before it does)
#
# and our own pid is skipped for good measure.
for _ng_proc in /proc/[0-9]*; do
    [ -r "$_ng_proc/cmdline" ] || continue
    [ "${_ng_proc#/proc/}" = "$$" ] && continue
    _ng_args=`tr '\0' ' ' < "$_ng_proc/cmdline" 2>/dev/null`
    case "$_ng_args" in
        "nginx: "*|*"$NGINX"*) kill -9 "${_ng_proc#/proc/}" 2>/dev/null ;;
    esac
done
unset _ng_proc _ng_args

# stderr is where nginx puts the reason it would not start, and s6-supervise
# hands this script the descriptors the scanner had, which is the s6 log --
# /usr/data/logs/s6.log, per init.d/S40s6. That is the right place for it: it
# is a file that outlives the boot, unlike the boot log S60nginx used to print
# into, and "see the error above" finally points at something you can read.
exec $NGINX -p $MODDIR/nginx -c $MODDIR/nginx/nginx.conf -g "daemon off;"
